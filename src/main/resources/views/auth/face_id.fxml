<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.FaceIdController"
      alignment="CENTER" spacing="0"
      style="-fx-background-color:#0d1117; -fx-background-radius:16;"
      prefWidth="420" prefHeight="500">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="6"
          style="-fx-background-color:#161b22;
                 -fx-padding:20 24 16 24;
                 -fx-border-color:transparent transparent #30363d transparent;
                 -fx-border-width:0 0 1 0;">
        <HBox alignment="CENTER" spacing="10">
            <StackPane minWidth="32" minHeight="32">
                <Circle radius="16" style="-fx-fill:rgba(5,150,105,0.2);"/>
                <Label text="ID" style="-fx-font-size:10; -fx-font-weight:900; -fx-text-fill:#34d399;"/>
            </StackPane>
            <Label text="Face ID"
                   style="-fx-font-size:18; -fx-font-weight:900; -fx-text-fill:#e6edf3;"/>
        </HBox>
        <Label fx:id="labelSubtitle" text="Authentification par reconnaissance faciale"
               style="-fx-font-size:12; -fx-text-fill:#8b949e;"
               wrapText="true" textAlignment="CENTER"/>
    </VBox>

    <!-- Status area (replaces camera preview) -->
    <StackPane prefHeight="200"
               style="-fx-background-color:#010409;">

        <!-- Hidden elements kept for FXML binding -->
        <javafx.scene.image.ImageView fx:id="cameraView" visible="false"/>
        <Ellipse fx:id="faceOverlay" radiusX="1" radiusY="1"
                 style="-fx-stroke:transparent; -fx-fill:transparent;" visible="false"/>

        <!-- Status display -->
        <VBox fx:id="statusOverlay" alignment="CENTER" spacing="16"
              style="-fx-background-color:#010409; -fx-padding:20;"
              maxWidth="420">

            <!-- Face icon animation area -->
            <StackPane minWidth="80" minHeight="80">
                <Circle radius="40"
                        style="-fx-fill:rgba(5,150,105,0.1);
                               -fx-stroke:rgba(5,150,105,0.4);
                               -fx-stroke-width:2;"/>
                <Label text="Face ID"
                       style="-fx-font-size:13; -fx-font-weight:700; -fx-text-fill:#34d399;"/>
            </StackPane>

            <Label fx:id="labelCameraStatus" text="Appuyez sur Demarrer"
                   style="-fx-font-size:13; -fx-font-weight:600; -fx-text-fill:#8b949e;"
                   wrapText="true" textAlignment="CENTER"/>

            <Label text="La camera s ouvre dans une fenetre separee"
                   style="-fx-font-size:11; -fx-text-fill:#484f58;"
                   wrapText="true" textAlignment="CENTER"/>
        </VBox>
    </StackPane>

    <!-- Progress bar -->
    <ProgressBar fx:id="progressBar" maxWidth="Infinity" prefHeight="4"
                 progress="0"
                 style="-fx-accent:#34d399; -fx-background-color:#21262d;"
                 visible="false" managed="false"/>

    <!-- Content -->
    <VBox spacing="12" style="-fx-padding:16 20 20 20;" VBox.vgrow="ALWAYS">

        <!-- Result message -->
        <Label fx:id="labelResult" text="" wrapText="true"
               style="-fx-font-size:12; -fx-font-weight:600;
                      -fx-background-radius:8; -fx-padding:10 14 10 14;
                      -fx-border-radius:8; -fx-border-width:1;"
               visible="false" managed="false"/>

        <!-- Tips -->
        <VBox spacing="4">
            <Label text="Comment ca marche :"
                   style="-fx-font-size:11; -fx-font-weight:600; -fx-text-fill:#8b949e;"/>
            <Label text="  1. Cliquez Demarrer"
                   style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
            <Label text="  2. La camera s ouvre automatiquement"
                   style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
            <Label text="  3. Placez votre visage face a la camera"
                   style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
            <Label text="  4. Restez immobile quelques secondes"
                   style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
        </VBox>

        <!-- Email field (login mode only) -->
        <VBox fx:id="emailBox" spacing="6">
            <Label text="Votre adresse email"
                   style="-fx-font-size:11; -fx-font-weight:600; -fx-text-fill:#8b949e;"/>
            <TextField fx:id="fieldEmail" promptText="exemple@domaine.com"
                       style="-fx-background-color:#21262d;
                              -fx-border-color:#30363d;
                              -fx-border-radius:8; -fx-background-radius:8;
                              -fx-padding:9 12 9 12; -fx-font-size:13;
                              -fx-text-fill:#e6edf3;
                              -fx-prompt-text-fill:#484f58;"/>
        </VBox>

        <!-- Buttons -->
        <HBox spacing="10">
            <Button fx:id="btnStart" text="Demarrer" onAction="#onStart"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color:#059669; -fx-text-fill:white;
                           -fx-font-size:13; -fx-font-weight:700;
                           -fx-padding:10 0 10 0; -fx-background-radius:10;
                           -fx-cursor:hand; -fx-border-width:0;"/>
            <Button fx:id="btnCancel" text="Annuler" onAction="#onCancel"
                    HBox.hgrow="ALWAYS" maxWidth="Infinity"
                    style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;
                           -fx-font-size:13; -fx-font-weight:600;
                           -fx-padding:10 0 10 0; -fx-background-radius:10;
                           -fx-cursor:hand; -fx-border-width:1;
                           -fx-border-color:#30363d; -fx-border-radius:10;"/>
        </HBox>
    </VBox>
</VBox>
