<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.evenement.front.SalleReservationController"
            prefWidth="1200" prefHeight="760"
            style="-fx-background-color:#050508;">

    <top>
        <fx:include source="../components/navbar_front.fxml" fx:id="navbar"/>
    </top>

    <center>
        <HBox spacing="0">

            <!-- Zone 3D WebView — prend toute la largeur disponible -->
            <StackPane fx:id="scene3DContainer" HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#050508;"/>

            <!-- Panneau latéral compact -->
            <VBox spacing="10" prefWidth="220" minWidth="200"
                  style="-fx-background-color:#0a0a14; -fx-padding:14;
                         -fx-border-color:rgba(139,92,246,0.3); -fx-border-width:0 0 0 1;">

                <!-- Info événement -->
                <VBox spacing="4"
                      style="-fx-background-color:rgba(139,92,246,0.1); -fx-background-radius:10;
                             -fx-border-color:rgba(139,92,246,0.3); -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Événement"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#a78bfa;"/>
                    <Label fx:id="labelEventName" text=""
                           wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#e2d9f3;"/>
                </VBox>

                <!-- Salle en cours -->
                <VBox spacing="4"
                      style="-fx-background-color:rgba(139,92,246,0.1); -fx-background-radius:10;
                             -fx-border-color:rgba(139,92,246,0.3); -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Salle en cours"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#a78bfa;"/>
                    <Label fx:id="labelSalleInfo" text="Couloir Principal"
                           wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#c4b5fd;"/>
                </VBox>

                <!-- Légende -->
                <VBox spacing="6"
                      style="-fx-background-color:rgba(139,92,246,0.1); -fx-background-radius:10;
                             -fx-border-color:rgba(139,92,246,0.3); -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Légende"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#a78bfa;"/>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#22c55e; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Disponible" style="-fx-font-size:10; -fx-text-fill:#d1fae5;"/>
                    </HBox>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#3b82f6; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Votre réservation" style="-fx-font-size:10; -fx-text-fill:#bfdbfe;"/>
                    </HBox>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#ef4444; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Occupée" style="-fx-font-size:10; -fx-text-fill:#fecaca;"/>
                    </HBox>
                </VBox>

                <!-- Statut sélection -->
                <VBox spacing="4"
                      style="-fx-background-color:rgba(139,92,246,0.1); -fx-background-radius:10;
                             -fx-border-color:rgba(139,92,246,0.3); -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Sélection"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#a78bfa;"/>
                    <Label fx:id="labelStatus" text="Naviguez et cliquez sur une table"
                           wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#888;"/>
                </VBox>

                <!-- Actions -->
                <VBox spacing="7">
                    <Button fx:id="btnReserver" text="Réserver cette table"
                            maxWidth="Infinity" onAction="#onReserver"
                            style="-fx-background-color:rgba(139,92,246,0.8); -fx-text-fill:white;
                                   -fx-font-size:12; -fx-font-weight:700;
                                   -fx-padding:10 0 10 0; -fx-background-radius:10;
                                   -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnLiberer" text="Libérer ma réservation"
                            maxWidth="Infinity" onAction="#onLiberer"
                            style="-fx-background-color:rgba(239,68,68,0.2); -fx-text-fill:#fca5a5;
                                   -fx-font-size:12; -fx-font-weight:700;
                                   -fx-padding:10 0 10 0; -fx-background-radius:10;
                                   -fx-cursor:hand; -fx-border-width:1;
                                   -fx-border-color:rgba(239,68,68,0.4); -fx-border-radius:10;"/>
                    <Button text="Retour aux participations"
                            maxWidth="Infinity" onAction="#onRetour"
                            style="-fx-background-color:transparent; -fx-text-fill:#a78bfa;
                                   -fx-font-size:11; -fx-font-weight:600;
                                   -fx-padding:8 0 8 0; -fx-background-radius:10;
                                   -fx-cursor:hand; -fx-border-color:rgba(139,92,246,0.3);
                                   -fx-border-radius:10; -fx-border-width:1;"/>
                </VBox>

            </VBox>
        </HBox>
    </center>
</BorderPane>
