<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.canvas.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.evenement.front.SalleReservationController"
            prefWidth="1200" prefHeight="760"
            style="-fx-background-color:#2C1A0E;">

    <top>
        <fx:include source="../components/navbar_front.fxml" fx:id="navbar"/>
    </top>

    <center>
        <HBox spacing="0">

            <!-- Zone Canvas 3D JavaFX -->
            <StackPane fx:id="scene3DContainer" HBox.hgrow="ALWAYS"
                       style="-fx-background-color:#1a0e06;">
                <Canvas fx:id="canvas3D"/>
            </StackPane>

            <!-- Panneau latéral -->
            <VBox spacing="10" prefWidth="230" minWidth="210"
                  style="-fx-background-color:#1A0D06; -fx-padding:14;
                         -fx-border-color:#8B6614; -fx-border-width:0 0 0 2;">

                <VBox spacing="4"
                      style="-fx-background-color:rgba(139,102,20,0.18); -fx-background-radius:10;
                             -fx-border-color:#8B6614; -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Événement"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#D4A96A;"/>
                    <Label fx:id="labelEventName" text="" wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#F5E6C8;"/>
                </VBox>

                <VBox spacing="6"
                      style="-fx-background-color:rgba(139,102,20,0.18); -fx-background-radius:10;
                             -fx-border-color:#8B6614; -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Navigation"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#D4A96A;"/>
                    <Button text="🏛  Entrée Principale"  maxWidth="Infinity" onAction="#onGoCorridor"
                            style="-fx-background-color:rgba(92,51,23,0.7); -fx-text-fill:#F5E6C8;
                                   -fx-font-size:11; -fx-padding:7 0; -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button text="🖥  Salle A — Hackathon" maxWidth="Infinity" onAction="#onGoSalleA"
                            style="-fx-background-color:rgba(92,51,23,0.7); -fx-text-fill:#F5E6C8;
                                   -fx-font-size:11; -fx-padding:7 0; -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button text="🔧  Salle B — Workshop"  maxWidth="Infinity" onAction="#onGoSalleB"
                            style="-fx-background-color:rgba(92,51,23,0.7); -fx-text-fill:#F5E6C8;
                                   -fx-font-size:11; -fx-padding:7 0; -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button text="🎮  Salle C — Gaming"    maxWidth="Infinity" onAction="#onGoSalleC"
                            style="-fx-background-color:rgba(92,51,23,0.7); -fx-text-fill:#F5E6C8;
                                   -fx-font-size:11; -fx-padding:7 0; -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:0;"/>
                </VBox>

                <VBox spacing="6"
                      style="-fx-background-color:rgba(139,102,20,0.18); -fx-background-radius:10;
                             -fx-border-color:#8B6614; -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Légende Tables"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#D4A96A;"/>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#22c55e; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Disponible" style="-fx-font-size:10; -fx-text-fill:#F5E6C8;"/>
                    </HBox>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#3b82f6; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Votre réservation" style="-fx-font-size:10; -fx-text-fill:#F5E6C8;"/>
                    </HBox>
                    <HBox spacing="7" alignment="CENTER_LEFT">
                        <Label style="-fx-background-color:#ef4444; -fx-min-width:12; -fx-min-height:12; -fx-background-radius:3;"/>
                        <Label text="Occupée" style="-fx-font-size:10; -fx-text-fill:#F5E6C8;"/>
                    </HBox>
                </VBox>

                <VBox spacing="4"
                      style="-fx-background-color:rgba(139,102,20,0.18); -fx-background-radius:10;
                             -fx-border-color:#8B6614; -fx-border-radius:10;
                             -fx-border-width:1; -fx-padding:10;">
                    <Label text="Sélection"
                           style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#D4A96A;"/>
                    <Label fx:id="labelStatus" text="Cliquez sur une table"
                           wrapText="true"
                           style="-fx-font-size:11; -fx-text-fill:#C4956A;"/>
                </VBox>

                <VBox spacing="7">
                    <Button fx:id="btnReserver" text="✅  Réserver cette table"
                            maxWidth="Infinity" onAction="#onReserver"
                            style="-fx-background-color:#8B6614; -fx-text-fill:#F5E6C8;
                                   -fx-font-size:12; -fx-font-weight:700;
                                   -fx-padding:10 0; -fx-background-radius:10; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnLiberer" text="🗑  Libérer ma réservation"
                            maxWidth="Infinity" onAction="#onLiberer"
                            style="-fx-background-color:rgba(239,68,68,0.25); -fx-text-fill:#fca5a5;
                                   -fx-font-size:12; -fx-font-weight:700;
                                   -fx-padding:10 0; -fx-background-radius:10; -fx-cursor:hand;
                                   -fx-border-width:1; -fx-border-color:rgba(239,68,68,0.5); -fx-border-radius:10;"/>
                    <Button text="← Retour" maxWidth="Infinity" onAction="#onRetour"
                            style="-fx-background-color:transparent; -fx-text-fill:#D4A96A;
                                   -fx-font-size:11; -fx-font-weight:600;
                                   -fx-padding:8 0; -fx-background-radius:10; -fx-cursor:hand;
                                   -fx-border-color:#8B6614; -fx-border-radius:10; -fx-border-width:1;"/>
                </VBox>

                <Label text="← → Salle précédente/suivante&#10;Clic = Sélectionner table"
                       wrapText="true"
                       style="-fx-font-size:10; -fx-text-fill:#8B6614; -fx-font-style:italic;"/>
            </VBox>
        </HBox>
    </center>

    <!-- EXTRA BOTTOM SPACE FOR SCROLLING -->
    <Region prefHeight="150" />

</BorderPane>