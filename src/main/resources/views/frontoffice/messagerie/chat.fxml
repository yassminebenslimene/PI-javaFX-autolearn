<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.MessagerieController"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color:#F5F6FA;">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SIDEBAR GAUCHE                                              -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox prefWidth="320" minWidth="280" maxWidth="340"
          style="-fx-background-color:white;
                 -fx-border-color:transparent #EAECF0 transparent transparent;
                 -fx-border-width:0 1 0 0;">

        <!-- Header sidebar -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding:20 16 16 20; -fx-background-color:white;">
            <Label text="Messages"
                   style="-fx-font-size:20; -fx-font-weight:900; -fx-text-fill:#1A1D23;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Badge non lus -->
            <Label fx:id="badgeNonLus" text="3"
                   style="-fx-background-color:#7C3AED; -fx-text-fill:white;
                          -fx-font-size:11; -fx-font-weight:700;
                          -fx-background-radius:50%; -fx-padding:3 8 3 8;"
                   visible="false" managed="false"/>
            <!-- Bouton notification -->
            <Button text="🔔" onAction="#onNotifications"
                    style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                           -fx-font-size:14; -fx-background-radius:50%;
                           -fx-min-width:36; -fx-min-height:36;
                           -fx-cursor:hand; -fx-border-width:0;"/>
        </HBox>

        <!-- Barre de recherche -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding:0 16 12 16;">
            <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:#F5F6FA; -fx-background-radius:12;
                         -fx-padding:10 14 10 14; -fx-border-width:0;">
                <Label text="🔍" style="-fx-font-size:13; -fx-text-fill:#9CA3AF;"/>
                <TextField fx:id="searchGlobal" promptText="Rechercher une conversation..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:transparent; -fx-border-width:0;
                                  -fx-font-size:13; -fx-text-fill:#374151;
                                  -fx-prompt-text-fill:#9CA3AF;"/>
            </HBox>
        </HBox>

        <!-- Onglets -->
        <HBox fx:id="tabBar" spacing="0"
              style="-fx-padding:0 16 0 16; -fx-border-color:transparent transparent #EAECF0 transparent;
                     -fx-border-width:0 0 1 0;">
            <Button fx:id="btnTabContacts" text="Contacts" onAction="#onTabContacts"
                    style="-fx-background-color:transparent; -fx-text-fill:#7C3AED;
                           -fx-font-size:13; -fx-font-weight:700; -fx-cursor:hand;
                           -fx-border-color:transparent transparent #7C3AED transparent;
                           -fx-border-width:0 0 2 0; -fx-padding:10 16 10 16;
                           -fx-background-radius:0;"/>
            <Button fx:id="btnTabEtudiants" text="Étudiants" onAction="#onTabEtudiants"
                    style="-fx-background-color:transparent; -fx-text-fill:#6B7280;
                           -fx-font-size:13; -fx-font-weight:600; -fx-cursor:hand;
                           -fx-border-width:0; -fx-padding:10 16 10 16;
                           -fx-background-radius:0;"/>
            <Button fx:id="btnTabDemandes" text="Demandes" onAction="#onTabDemandes"
                    style="-fx-background-color:transparent; -fx-text-fill:#6B7280;
                           -fx-font-size:13; -fx-font-weight:600; -fx-cursor:hand;
                           -fx-border-width:0; -fx-padding:10 16 10 16;
                           -fx-background-radius:0;"/>
            <Label fx:id="badgeDemandes" text=""
                   style="-fx-background-color:#EF4444; -fx-text-fill:white;
                          -fx-font-size:10; -fx-font-weight:700;
                          -fx-background-radius:50%; -fx-padding:2 6 2 6;"
                   visible="false" managed="false"/>
        </HBox>

        <!-- Contenu des onglets (stacké) -->
        <StackPane VBox.vgrow="ALWAYS">

            <!-- Onglet Contacts -->
            <VBox fx:id="paneContacts" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER"
                            style="-fx-background-color:white; -fx-background:white;
                                   -fx-border-width:0;">
                    <VBox fx:id="listContacts" spacing="0"
                          style="-fx-background-color:white; -fx-padding:8 0 8 0;"/>
                </ScrollPane>
            </VBox>

            <!-- Onglet Étudiants -->
            <VBox fx:id="paneEtudiants" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER"
                            style="-fx-background-color:white; -fx-background:white;
                                   -fx-border-width:0;">
                    <VBox fx:id="listEtudiants" spacing="0"
                          style="-fx-background-color:white; -fx-padding:8 0 8 0;"/>
                </ScrollPane>
            </VBox>

            <!-- Onglet Demandes -->
            <VBox fx:id="paneDemandes" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER"
                            style="-fx-background-color:white; -fx-background:white;
                                   -fx-border-width:0;">
                    <VBox fx:id="listDemandes" spacing="0"
                          style="-fx-background-color:white; -fx-padding:8 0 8 0;"/>
                </ScrollPane>
            </VBox>

        </StackPane>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ZONE CENTRALE — Chat                                        -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" maxHeight="Infinity">

        <!-- État vide -->
        <VBox fx:id="panneauVide" alignment="CENTER" spacing="20"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color:#F5F6FA;">
            <Label text="💬" style="-fx-font-size:72;"/>
            <Label text="Vos conversations"
                   style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#1A1D23;"/>
            <Label text="Sélectionnez un contact pour commencer à discuter,&#10;ou envoyez une demande de suivi à un étudiant."
                   style="-fx-font-size:14; -fx-text-fill:#9CA3AF; -fx-text-alignment:CENTER;"
                   wrapText="true" maxWidth="340" alignment="CENTER"/>
        </VBox>

        <!-- Zone de chat active -->
        <VBox fx:id="panneauChat" VBox.vgrow="ALWAYS" visible="false" managed="false"
              maxHeight="Infinity" style="-fx-background-color:#F5F6FA;">

            <!-- Header contact -->
            <HBox alignment="CENTER_LEFT" spacing="14"
                  style="-fx-padding:14 20 14 20; -fx-background-color:white;
                         -fx-border-color:transparent transparent #EAECF0 transparent;
                         -fx-border-width:0 0 1 0;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.05),8,0,0,2);">

                <!-- Avatar avec cercle coloré -->
                <StackPane>
                    <Circle radius="22"
                            style="-fx-fill:linear-gradient(to bottom right,#7C3AED,#A78BFA);"/>
                    <Label fx:id="labelAvatarChat"
                           style="-fx-text-fill:white; -fx-font-weight:800; -fx-font-size:14;"/>
                </StackPane>

                <VBox spacing="3">
                    <Label fx:id="labelNomContact"
                           style="-fx-font-size:15; -fx-font-weight:800; -fx-text-fill:#1A1D23;"/>
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Circle radius="4" style="-fx-fill:#22C55E;"/>
                        <Label fx:id="labelStatutContact" text="Actif maintenant"
                               style="-fx-font-size:11; -fx-text-fill:#22C55E; -fx-font-weight:600;"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <!-- Bouton recherche dans messages -->
                <Button fx:id="btnRechercheMsg" text="🔍" onAction="#onRechercheMessages"
                        style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                               -fx-font-size:14; -fx-background-radius:50%;
                               -fx-min-width:36; -fx-min-height:36;
                               -fx-cursor:hand; -fx-border-width:0;"/>

                <!-- Mode sombre -->
                <Button fx:id="btnModeSombre" text="🌙" onAction="#onToggleModeSombre"
                        style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                               -fx-font-size:14; -fx-background-radius:50%;
                               -fx-min-width:36; -fx-min-height:36;
                               -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Barre de recherche dans messages (cachée par défaut) -->
            <HBox fx:id="barreRechercheMsg" alignment="CENTER_LEFT" spacing="8"
                  visible="false" managed="false"
                  style="-fx-padding:8 16 8 16; -fx-background-color:#F0EBFF;
                         -fx-border-color:transparent transparent #DDD6FE transparent;
                         -fx-border-width:0 0 1 0;">
                <Label text="🔍" style="-fx-font-size:13; -fx-text-fill:#7C3AED;"/>
                <TextField fx:id="champRechercheMsg" promptText="Rechercher dans la conversation..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:transparent; -fx-border-width:0;
                                  -fx-font-size:13; -fx-text-fill:#374151;"/>
                <Button text="✕" onAction="#onFermerRechercheMessages"
                        style="-fx-background-color:transparent; -fx-text-fill:#9CA3AF;
                               -fx-font-size:13; -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Zone des messages -->
            <ScrollPane fx:id="scrollMessages" fitToWidth="true"
                        VBox.vgrow="ALWAYS" hbarPolicy="NEVER"
                        style="-fx-background-color:#F5F6FA; -fx-background:#F5F6FA;
                               -fx-border-width:0;">
                <VBox fx:id="containerMessages" spacing="4"
                      style="-fx-padding:20 24 12 24; -fx-background-color:#F5F6FA;">
                </VBox>
            </ScrollPane>

            <!-- Indicateur "est en train d'écrire" -->
            <HBox fx:id="indicateurEcriture" alignment="CENTER_LEFT" spacing="8"
                  visible="false" managed="false"
                  style="-fx-padding:4 24 4 24; -fx-background-color:#F5F6FA;">
                <Label fx:id="labelEcriture" text="asma est en train d'écrire..."
                       style="-fx-font-size:12; -fx-text-fill:#9CA3AF; -fx-font-style:italic;"/>
            </HBox>

            <!-- Zone de saisie -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding:12 16 12 16; -fx-background-color:white;
                         -fx-border-color:#EAECF0 transparent transparent transparent;
                         -fx-border-width:1 0 0 0;">

                <!-- Bouton emoji -->
                <Button text="😊"
                        style="-fx-background-color:transparent; -fx-text-fill:#9CA3AF;
                               -fx-font-size:18; -fx-cursor:hand; -fx-border-width:0;
                               -fx-padding:4 6 4 6;"/>

                <!-- Champ de saisie -->
                <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"
                      style="-fx-background-color:#F5F6FA; -fx-background-radius:24;
                             -fx-border-color:#E5E7EB; -fx-border-radius:24;
                             -fx-border-width:1; -fx-padding:0 12 0 16;">
                    <TextField fx:id="champMessage"
                               promptText="Tapez votre message..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:transparent; -fx-border-width:0;
                                      -fx-font-size:13; -fx-text-fill:#374151;
                                      -fx-prompt-text-fill:#9CA3AF;
                                      -fx-padding:11 0 11 0;"/>
                </HBox>

                <!-- Bouton envoyer -->
                <Button fx:id="btnEnvoyer" text="➤" onAction="#onEnvoyerMessage"
                        style="-fx-background-color:linear-gradient(to bottom right,#7C3AED,#6D28D9);
                               -fx-text-fill:white; -fx-font-size:15; -fx-font-weight:700;
                               -fx-background-radius:50%; -fx-min-width:44; -fx-min-height:44;
                               -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(124,58,237,0.35),12,0,0,4);"/>
            </HBox>
        </VBox>

    </VBox>

</HBox>
