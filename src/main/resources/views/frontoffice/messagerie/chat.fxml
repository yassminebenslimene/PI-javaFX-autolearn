<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<!--
    chat.fxml — Messagerie en temps réel entre étudiants
    Contrôleur : MessagerieController

    Structure :
      HBox racine
      ├── VBox gauche (280px) — liste contacts + étudiants + demandes
      │   ├── Onglets : Contacts | Étudiants | Demandes
      │   └── ListView pour chaque onglet
      └── VBox droite — zone de chat
          ├── HBox header (nom du contact actif)
          ├── ScrollPane (bulles de messages)
          └── HBox bas (champ texte + bouton envoyer)
-->
<HBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="tn.esprit.controllers.MessagerieController"
      maxWidth="Infinity" maxHeight="Infinity"
      style="-fx-background-color:#f8f7ff;">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- PANNEAU GAUCHE : contacts, étudiants, demandes             -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox prefWidth="300" minWidth="260" maxWidth="320"
          style="-fx-background-color:white;
                 -fx-border-color:#e8e4ff transparent transparent transparent;
                 -fx-border-width:0 1 0 0;">

        <!-- En-tête -->
        <HBox alignment="CENTER_LEFT" spacing="10"
              style="-fx-padding:20 16 14 16; -fx-background-color:#7c3aed;">
            <Label text="💬  Messagerie"
                   style="-fx-font-size:16; -fx-font-weight:900; -fx-text-fill:white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <!-- Badge messages non lus -->
            <Label fx:id="badgeNonLus" text=""
                   style="-fx-background-color:#ef4444; -fx-text-fill:white;
                          -fx-font-size:11; -fx-font-weight:700;
                          -fx-background-radius:50%; -fx-padding:2 7 2 7;"
                   visible="false" managed="false"/>
        </HBox>

        <!-- Onglets -->
        <TabPane fx:id="tabPane" tabClosingPolicy="UNAVAILABLE"
                 style="-fx-tab-min-height:36; -fx-background-color:white;">

            <!-- Onglet Contacts -->
            <Tab text="Contacts" fx:id="tabContacts">
                <VBox spacing="0">
                    <TextField fx:id="searchContacts" promptText="🔍  Rechercher..."
                               style="-fx-background-color:#f8f7ff; -fx-border-color:#e8e4ff;
                                      -fx-border-width:0 0 1 0; -fx-padding:10 14 10 14;
                                      -fx-font-size:13; -fx-background-radius:0;"/>
                    <ListView fx:id="listContacts"
                              style="-fx-background-color:white; -fx-border-width:0;"
                              prefHeight="500"/>
                </VBox>
            </Tab>

            <!-- Onglet Étudiants -->
            <Tab text="Étudiants" fx:id="tabEtudiants">
                <VBox spacing="0">
                    <TextField fx:id="searchEtudiants" promptText="🔍  Rechercher..."
                               style="-fx-background-color:#f8f7ff; -fx-border-color:#e8e4ff;
                                      -fx-border-width:0 0 1 0; -fx-padding:10 14 10 14;
                                      -fx-font-size:13; -fx-background-radius:0;"/>
                    <ListView fx:id="listEtudiants"
                              style="-fx-background-color:white; -fx-border-width:0;"
                              prefHeight="500"/>
                </VBox>
            </Tab>

            <!-- Onglet Demandes reçues -->
            <Tab text="Demandes" fx:id="tabDemandes">
                <ListView fx:id="listDemandes"
                          style="-fx-background-color:white; -fx-border-width:0;"
                          prefHeight="540"/>
            </Tab>

        </TabPane>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ZONE DE CHAT (droite)                                       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" maxHeight="Infinity">

        <!-- État vide (aucun contact sélectionné) -->
        <VBox fx:id="panneauVide" alignment="CENTER" spacing="16"
              VBox.vgrow="ALWAYS"
              style="-fx-background-color:#f8f7ff;">
            <Label text="💬" style="-fx-font-size:64;"/>
            <Label text="Sélectionnez un contact pour commencer à chatter"
                   style="-fx-font-size:15; -fx-text-fill:#94a3b8; -fx-font-weight:600;"
                   wrapText="true" maxWidth="300"/>
            <Label text="Ou envoyez une demande de suivi à un étudiant"
                   style="-fx-font-size:13; -fx-text-fill:#b0b8c8;"
                   wrapText="true" maxWidth="300"/>
        </VBox>

        <!-- Zone de chat active -->
        <VBox fx:id="panneauChat" VBox.vgrow="ALWAYS" visible="false" managed="false"
              maxHeight="Infinity">

            <!-- Header contact actif -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-padding:14 20 14 20; -fx-background-color:white;
                         -fx-border-color:#e8e4ff transparent transparent transparent;
                         -fx-border-width:0 0 1 0;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.06),8,0,0,2);">
                <!-- Avatar -->
                <Label fx:id="labelAvatarChat"
                       style="-fx-background-color:#7c3aed; -fx-text-fill:white;
                              -fx-font-weight:700; -fx-font-size:14;
                              -fx-background-radius:50%; -fx-padding:8 11 8 11;"/>
                <VBox spacing="2">
                    <Label fx:id="labelNomContact"
                           style="-fx-font-size:15; -fx-font-weight:800; -fx-text-fill:#0f172a;"/>
                    <Label fx:id="labelStatutContact" text="● En ligne"
                           style="-fx-font-size:11; -fx-text-fill:#22c55e;"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <!-- Indicateur de rafraîchissement -->
                <Label fx:id="labelRefresh" text="🔄"
                       style="-fx-font-size:12; -fx-text-fill:#94a3b8;"/>
            </HBox>

            <!-- Zone des messages -->
            <ScrollPane fx:id="scrollMessages" fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER"
                        style="-fx-background-color:#f8f7ff; -fx-background:#f8f7ff;
                               -fx-border-width:0;">
                <VBox fx:id="containerMessages" spacing="8"
                      style="-fx-padding:16 20 16 20; -fx-background-color:#f8f7ff;">
                </VBox>
            </ScrollPane>

            <!-- Zone de saisie -->
            <HBox alignment="CENTER" spacing="10"
                  style="-fx-padding:12 16 12 16; -fx-background-color:white;
                         -fx-border-color:#e8e4ff transparent transparent transparent;
                         -fx-border-width:1 0 0 0;">
                <TextField fx:id="champMessage"
                           promptText="Écrire un message..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:#f8f7ff; -fx-border-color:#ddd6fe;
                                  -fx-border-radius:22; -fx-background-radius:22;
                                  -fx-padding:10 16 10 16; -fx-font-size:13;"/>
                <Button fx:id="btnEnvoyer" text="➤" onAction="#onEnvoyerMessage"
                        style="-fx-background-color:#7c3aed; -fx-text-fill:white;
                               -fx-font-size:16; -fx-font-weight:700;
                               -fx-background-radius:50%; -fx-min-width:42; -fx-min-height:42;
                               -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(124,58,237,0.4),10,0,0,3);"/>
            </HBox>
        </VBox>

    </VBox>

</HBox>
