<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<!--
    Racine : AnchorPane → s'étire automatiquement dans BorderPane.center
    Sidebar : AnchorPane left=0 top=0 bottom=0 width=300
    Chat    : AnchorPane left=300 right=0 top=0 bottom=0
    BorderPane interne pour le chat : top=header, center=scroll, bottom=input
-->
<AnchorPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.MessagerieController"
            style="-fx-background-color:#F5F6FA;">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- SIDEBAR (ancré gauche, largeur fixe 300px)                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox AnchorPane.leftAnchor="0" AnchorPane.topAnchor="0"
          AnchorPane.bottomAnchor="0" prefWidth="300"
          style="-fx-background-color:white;
                 -fx-border-color:transparent #EAECF0 transparent transparent;
                 -fx-border-width:0 1 0 0;">

        <!-- Header -->
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding:18 16 14 20; -fx-background-color:white;">
            <Label text="Messages"
                   style="-fx-font-size:20; -fx-font-weight:900; -fx-text-fill:#1A1D23;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="badgeNonLus" text=""
                   style="-fx-background-color:#7C3AED; -fx-text-fill:white;
                          -fx-font-size:11; -fx-font-weight:700;
                          -fx-background-radius:50%; -fx-padding:3 8 3 8;"
                   visible="false" managed="false"/>
            <Button text="🔔" onAction="#onNotifications"
                    style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                           -fx-font-size:14; -fx-background-radius:50%;
                           -fx-min-width:36; -fx-min-height:36;
                           -fx-cursor:hand; -fx-border-width:0;"/>
        </HBox>

        <!-- Recherche -->
        <HBox alignment="CENTER_LEFT" spacing="8"
              style="-fx-padding:0 14 10 14;">
            <HBox alignment="CENTER_LEFT" spacing="8" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:#F5F6FA; -fx-background-radius:12;
                         -fx-padding:9 14 9 14;">
                <Label text="🔍" style="-fx-font-size:12; -fx-text-fill:#9CA3AF;"/>
                <TextField fx:id="searchGlobal" promptText="Rechercher..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:transparent; -fx-border-width:0;
                                  -fx-font-size:13; -fx-text-fill:#374151;
                                  -fx-prompt-text-fill:#9CA3AF;"/>
            </HBox>
        </HBox>

        <!-- Onglets -->
        <HBox spacing="0"
              style="-fx-border-color:transparent transparent #EAECF0 transparent;
                     -fx-border-width:0 0 1 0; -fx-padding:0 8 0 8;">
            <Button fx:id="btnTabContacts" text="Contacts" onAction="#onTabContacts"
                    style="-fx-background-color:transparent; -fx-text-fill:#7C3AED;
                           -fx-font-size:12; -fx-font-weight:700; -fx-cursor:hand;
                           -fx-border-color:transparent transparent #7C3AED transparent;
                           -fx-border-width:0 0 2 0; -fx-padding:9 14 9 14;
                           -fx-background-radius:0;"/>
            <Button fx:id="btnTabEtudiants" text="Étudiants" onAction="#onTabEtudiants"
                    style="-fx-background-color:transparent; -fx-text-fill:#6B7280;
                           -fx-font-size:12; -fx-font-weight:600; -fx-cursor:hand;
                           -fx-border-width:0; -fx-padding:9 14 9 14; -fx-background-radius:0;"/>
            <Button fx:id="btnTabDemandes" text="Demandes" onAction="#onTabDemandes"
                    style="-fx-background-color:transparent; -fx-text-fill:#6B7280;
                           -fx-font-size:12; -fx-font-weight:600; -fx-cursor:hand;
                           -fx-border-width:0; -fx-padding:9 14 9 14; -fx-background-radius:0;"/>
            <Label fx:id="badgeDemandes" text=""
                   style="-fx-background-color:#EF4444; -fx-text-fill:white;
                          -fx-font-size:10; -fx-font-weight:700;
                          -fx-background-radius:50%; -fx-padding:2 6 2 6;"
                   visible="false" managed="false"/>
        </HBox>

        <!-- Listes -->
        <StackPane VBox.vgrow="ALWAYS">
            <VBox fx:id="paneContacts">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color:white; -fx-background:white; -fx-border-width:0;"
                            prefHeight="600">
                    <VBox fx:id="listContacts" spacing="0"
                          style="-fx-background-color:white; -fx-padding:6 0 6 0;"/>
                </ScrollPane>
            </VBox>
            <VBox fx:id="paneEtudiants" visible="false" managed="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color:white; -fx-background:white; -fx-border-width:0;"
                            prefHeight="600">
                    <VBox fx:id="listEtudiants" spacing="0"
                          style="-fx-background-color:white; -fx-padding:6 0 6 0;"/>
                </ScrollPane>
            </VBox>
            <VBox fx:id="paneDemandes" visible="false" managed="false">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color:white; -fx-background:white; -fx-border-width:0;"
                            prefHeight="600">
                    <VBox fx:id="listDemandes" spacing="0"
                          style="-fx-background-color:white; -fx-padding:6 0 6 0;"/>
                </ScrollPane>
            </VBox>
        </StackPane>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ZONE VIDE (ancré droite, visible quand aucun contact)       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox fx:id="panneauVide"
          AnchorPane.leftAnchor="300" AnchorPane.rightAnchor="0"
          AnchorPane.topAnchor="0"   AnchorPane.bottomAnchor="0"
          alignment="CENTER" spacing="20"
          style="-fx-background-color:#F5F6FA;">
        <Label text="💬" style="-fx-font-size:72;"/>
        <Label text="Vos conversations"
               style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#1A1D23;"/>
        <Label text="Sélectionnez un contact pour commencer à discuter."
               style="-fx-font-size:14; -fx-text-fill:#9CA3AF; -fx-text-alignment:CENTER;"
               wrapText="true" maxWidth="320" alignment="CENTER"/>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- ZONE CHAT (BorderPane ancré droite, caché par défaut)       -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <BorderPane fx:id="panneauChat"
                AnchorPane.leftAnchor="300" AnchorPane.rightAnchor="0"
                AnchorPane.topAnchor="0"   AnchorPane.bottomAnchor="0"
                visible="false" managed="false"
                style="-fx-background-color:#F5F6FA;">

        <!-- TOP : header -->
        <top>
            <VBox style="-fx-background-color:white;">
                <HBox alignment="CENTER_LEFT" spacing="14"
                      style="-fx-padding:12 20 12 20;
                             -fx-border-color:transparent transparent #EAECF0 transparent;
                             -fx-border-width:0 0 1 0;">
                    <StackPane>
                        <Circle radius="22"
                                style="-fx-fill:linear-gradient(to bottom right,#7C3AED,#A78BFA);"/>
                        <Label fx:id="labelAvatarChat"
                               style="-fx-text-fill:white; -fx-font-weight:800; -fx-font-size:14;"/>
                    </StackPane>
                    <VBox spacing="2">
                        <Label fx:id="labelNomContact"
                               style="-fx-font-size:15; -fx-font-weight:800; -fx-text-fill:#1A1D23;"/>
                        <HBox alignment="CENTER_LEFT" spacing="5">
                            <Circle radius="4" style="-fx-fill:#22C55E;"/>
                            <Label fx:id="labelStatutContact" text="Actif maintenant"
                                   style="-fx-font-size:11; -fx-text-fill:#22C55E; -fx-font-weight:600;"/>
                        </HBox>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnRechercheMsg" text="🔍" onAction="#onRechercheMessages"
                            style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                                   -fx-font-size:14; -fx-background-radius:50%;
                                   -fx-min-width:36; -fx-min-height:36;
                                   -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnModeSombre" text="🌙" onAction="#onToggleModeSombre"
                            style="-fx-background-color:#F5F6FA; -fx-text-fill:#6B7280;
                                   -fx-font-size:14; -fx-background-radius:50%;
                                   -fx-min-width:36; -fx-min-height:36;
                                   -fx-cursor:hand; -fx-border-width:0;"/>
                </HBox>
                <!-- Barre recherche messages -->
                <HBox fx:id="barreRechercheMsg" alignment="CENTER_LEFT" spacing="8"
                      visible="false" managed="false"
                      style="-fx-padding:8 16 8 16; -fx-background-color:#F0EBFF;
                             -fx-border-color:transparent transparent #DDD6FE transparent;
                             -fx-border-width:0 0 1 0;">
                    <Label text="🔍" style="-fx-font-size:13; -fx-text-fill:#7C3AED;"/>
                    <TextField fx:id="champRechercheMsg" promptText="Rechercher dans la conversation..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:transparent; -fx-border-width:0;
                                      -fx-font-size:13; -fx-text-fill:#374151;"/>
                    <Button text="✕" onAction="#onFermerRechercheMessages"
                            style="-fx-background-color:transparent; -fx-text-fill:#9CA3AF;
                                   -fx-font-size:13; -fx-cursor:hand; -fx-border-width:0;"/>
                </HBox>
            </VBox>
        </top>

        <!-- CENTER : messages (prend TOUT l'espace entre top et bottom) -->
        <center>
            <ScrollPane fx:id="scrollMessages"
                        fitToWidth="true" pannable="true"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color:#F5F6FA; -fx-background:#F5F6FA;
                               -fx-border-width:0;">
                <VBox fx:id="containerMessages" spacing="4"
                      alignment="TOP_LEFT"
                      style="-fx-padding:16 20 36 20; -fx-background-color:#F5F6FA;"/>
            </ScrollPane>
        </center>

        <!-- BOTTOM : saisie (hauteur fixe) -->
        <bottom>
            <VBox style="-fx-background-color:white;">
                <!-- Indicateur typing -->
                <HBox fx:id="indicateurEcriture" alignment="CENTER_LEFT" spacing="8"
                      visible="false" managed="false"
                      style="-fx-padding:4 20 4 20; -fx-background-color:#F5F6FA;">
                    <Label fx:id="labelEcriture" text="est en train d'écrire..."
                           style="-fx-font-size:11; -fx-text-fill:#9CA3AF; -fx-font-style:italic;"/>
                </HBox>
                <!-- Barre de saisie -->
                <HBox alignment="CENTER" spacing="8"
                      style="-fx-padding:10 14 20 14;
                             -fx-border-color:#EAECF0 transparent transparent transparent;
                             -fx-border-width:1 0 0 0;">
                    <Button fx:id="btnEmoji" text="😊" onAction="#onOuvrirEmojis"
                            style="-fx-background-color:transparent; -fx-text-fill:#9CA3AF;
                                   -fx-font-size:18; -fx-cursor:hand; -fx-border-width:0;
                                   -fx-padding:4 5 4 5;"/>
                    <Button fx:id="btnFichier" text="📎" onAction="#onEnvoyerFichier"
                            style="-fx-background-color:transparent; -fx-text-fill:#9CA3AF;
                                   -fx-font-size:18; -fx-cursor:hand; -fx-border-width:0;
                                   -fx-padding:4 5 4 5;"/>
                    <HBox HBox.hgrow="ALWAYS" alignment="CENTER_LEFT"
                          style="-fx-background-color:#F5F6FA; -fx-background-radius:22;
                                 -fx-border-color:#E5E7EB; -fx-border-radius:22;
                                 -fx-border-width:1; -fx-padding:0 12 0 14;">
                        <TextField fx:id="champMessage"
                                   promptText="Tapez votre message..."
                                   HBox.hgrow="ALWAYS"
                                   style="-fx-background-color:transparent; -fx-border-width:0;
                                          -fx-font-size:13; -fx-text-fill:#374151;
                                          -fx-prompt-text-fill:#9CA3AF;
                                          -fx-padding:10 0 10 0;"/>
                    </HBox>
                    <Button fx:id="btnEnvoyer" text="➤" onAction="#onEnvoyerMessage"
                            style="-fx-background-color:linear-gradient(to bottom right,#7C3AED,#6D28D9);
                                   -fx-text-fill:white; -fx-font-size:15; -fx-font-weight:700;
                                   -fx-background-radius:50%; -fx-min-width:42; -fx-min-height:42;
                                   -fx-cursor:hand; -fx-border-width:0;
                                   -fx-effect:dropshadow(gaussian,rgba(124,58,237,0.3),10,0,0,3);"/>
                </HBox>
            </VBox>
        </bottom>

    </BorderPane>


    <!-- EXTRA BOTTOM SPACE FOR SCROLLING -->
    <Region prefHeight="150" />

</AnchorPane>