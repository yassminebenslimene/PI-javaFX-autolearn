<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<!--
    Floating AI Assistant.
    The root StackPane is mouseTransparent by default — the controller
    sets it to false only for the actual button/panel area via the
    assistantContainer VBox. This guarantees zero interference with
    the rest of the page.
-->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:id="rootPane"
           fx:controller="tn.esprit.controllers.StudentAssistantController"
           alignment="BOTTOM_RIGHT"
           pickOnBounds="false"
           mouseTransparent="true"
           style="-fx-background-color:transparent;">

    <!-- This VBox is the ONLY thing that can receive mouse events.
         It is sized to its content (chat panel + button) and pinned
         to the bottom-right. Everything outside it is transparent. -->
    <VBox fx:id="assistantContainer"
          alignment="BOTTOM_RIGHT"
          pickOnBounds="true"
          mouseTransparent="false"
          spacing="0"
          StackPane.alignment="BOTTOM_RIGHT"
          style="-fx-padding:0 20 20 0; -fx-background-color:transparent;">

        <!-- ══ CHAT PANEL ══ -->
        <VBox fx:id="chatPanel" spacing="0"
              prefWidth="320" prefHeight="560"
              minWidth="320" maxWidth="320"
              minHeight="560" maxHeight="560"
              visible="false" managed="false"
              style="-fx-background-color:white;
                     -fx-background-radius:16;
                     -fx-border-color:#ddd6fe; -fx-border-radius:16; -fx-border-width:1.5;
                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.28),30,0,0,10);">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color:linear-gradient(to right,#6d28d9,#7c3aed);
                         -fx-background-radius:16 16 0 0;
                         -fx-padding:12 14 12 14;
                         -fx-min-height:56; -fx-max-height:56;">
                <StackPane minWidth="36" minHeight="36" maxWidth="36" maxHeight="36">
                    <Circle radius="18" style="-fx-fill:rgba(255,255,255,0.2);"/>
                    <Label text="✦" style="-fx-font-size:13; -fx-font-weight:900; -fx-text-fill:white;"/>
                </StackPane>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="Assistant AutoLearn"
                           style="-fx-font-size:12; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <HBox spacing="4" alignment="CENTER_LEFT">
                        <Circle radius="3" style="-fx-fill:#86efac;"/>
                        <Label fx:id="labelStatus" text="En ligne"
                               style="-fx-font-size:10; -fx-text-fill:rgba(255,255,255,0.75);"/>
                    </HBox>
                </VBox>
                <Button text="↺" onAction="#onClear"
                        style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white;
                               -fx-font-size:13; -fx-min-width:28; -fx-min-height:28;
                               -fx-max-width:28; -fx-max-height:28;
                               -fx-background-radius:50%; -fx-cursor:hand; -fx-border-width:0;"/>
                <Button text="✕" onAction="#onToggle"
                        style="-fx-background-color:rgba(255,255,255,0.15); -fx-text-fill:white;
                               -fx-font-size:10; -fx-min-width:28; -fx-min-height:28;
                               -fx-max-width:28; -fx-max-height:28;
                               -fx-background-radius:50%; -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Messages -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color:#faf8ff; -fx-background:#faf8ff; -fx-border-width:0;">
                <VBox fx:id="messagesBox" spacing="8"
                      style="-fx-padding:12 10 12 10; -fx-background-color:#faf8ff;"/>
            </ScrollPane>

            <!-- Input bar -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color:white;
                         -fx-background-radius:0 0 16 16;
                         -fx-border-color:#ede9fe transparent transparent transparent;
                         -fx-border-width:1 0 0 0;
                         -fx-padding:10 12 12 12;
                         -fx-min-height:56; -fx-max-height:56;">
                <TextField fx:id="inputField"
                           promptText="Écrivez un message..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:#f5f3ff;
                                  -fx-background-radius:20;
                                  -fx-border-color:#ddd6fe; -fx-border-radius:20; -fx-border-width:1;
                                  -fx-padding:8 12; -fx-font-size:12;
                                  -fx-text-fill:#1e1b4b; -fx-prompt-text-fill:#a78bfa;"/>
                <Button fx:id="btnSend" text="▶" onAction="#onSend"
                        style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                               -fx-text-fill:white; -fx-font-size:12; -fx-font-weight:900;
                               -fx-min-width:36; -fx-min-height:36;
                               -fx-max-width:36; -fx-max-height:36;
                               -fx-background-radius:50%; -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.4),6,0,0,2);"/>
            </HBox>
        </VBox>

        <!-- ══ TOGGLE BUTTON ══ -->
        <HBox alignment="CENTER_RIGHT" pickOnBounds="false"
              style="-fx-padding:8 0 0 0;">
            <StackPane alignment="CENTER" pickOnBounds="false"
                       minWidth="70" maxWidth="70"
                       minHeight="70" maxHeight="70">
                <Circle radius="32" style="-fx-fill:rgba(124,58,237,0.12);" mouseTransparent="true"/>
                <Button fx:id="btnToggle" text="💬" onAction="#onToggle"
                        style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                               -fx-text-fill:white; -fx-font-size:20;
                               -fx-min-width:54; -fx-min-height:54;
                               -fx-max-width:54; -fx-max-height:54;
                               -fx-background-radius:50%; -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.6),16,0,0,5);"
                        alignment="CENTER"/>
            </StackPane>
        </HBox>

    </VBox>
</StackPane>
