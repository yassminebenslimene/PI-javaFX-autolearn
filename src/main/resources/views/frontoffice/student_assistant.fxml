<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<!-- Floating AI Assistant - always visible on all frontoffice pages -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.controllers.StudentAssistantController"
           alignment="BOTTOM_RIGHT"
           pickOnBounds="false"
           style="-fx-background-color:transparent;">

    <VBox alignment="BOTTOM_RIGHT" spacing="10" pickOnBounds="false"
          style="-fx-padding:0 20 20 0;">

        <!-- ══════════ CHAT PANEL ══════════ -->
        <VBox fx:id="chatPanel" spacing="0"
              prefWidth="340" prefHeight="500"
              visible="false" managed="false"
              style="-fx-background-color:white;
                     -fx-background-radius:20;
                     -fx-border-color:#ddd6fe; -fx-border-radius:20; -fx-border-width:1.5;
                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.22),28,0,0,10);">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="10"
                  style="-fx-background-color:linear-gradient(to right,#6d28d9,#7c3aed,#4f46e5);
                         -fx-background-radius:20 20 0 0;
                         -fx-padding:14 16 14 16;">

                <!-- Animated avatar -->
                <StackPane minWidth="38" minHeight="38" maxWidth="38" maxHeight="38">
                    <Circle radius="19"
                            style="-fx-fill:rgba(255,255,255,0.18);"/>
                    <Circle radius="14"
                            style="-fx-fill:rgba(255,255,255,0.12);"/>
                    <Label text="✦"
                           style="-fx-font-size:14; -fx-font-weight:900; -fx-text-fill:white;"/>
                </StackPane>

                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="Assistant AutoLearn"
                           style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <HBox spacing="5" alignment="CENTER_LEFT">
                        <Circle radius="3.5" style="-fx-fill:#86efac;"/>
                        <Label fx:id="labelStatus" text="● En ligne"
                               style="-fx-font-size:10; -fx-text-fill:rgba(255,255,255,0.8);"/>
                    </HBox>
                </VBox>

                <!-- Clear button -->
                <Button text="↺" onAction="#onClear"
                        style="-fx-background-color:rgba(255,255,255,0.12);
                               -fx-text-fill:rgba(255,255,255,0.9); -fx-font-size:14;
                               -fx-min-width:30; -fx-min-height:30;
                               -fx-max-width:30; -fx-max-height:30;
                               -fx-background-radius:50%;
                               -fx-cursor:hand; -fx-border-width:0;"/>

                <!-- Close button -->
                <Button text="✕" onAction="#onToggle"
                        style="-fx-background-color:rgba(255,255,255,0.12);
                               -fx-text-fill:rgba(255,255,255,0.9); -fx-font-size:11;
                               -fx-min-width:30; -fx-min-height:30;
                               -fx-max-width:30; -fx-max-height:30;
                               -fx-background-radius:50%;
                               -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Messages area -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color:#faf8ff; -fx-background:#faf8ff; -fx-border-width:0;">
                <VBox fx:id="messagesBox" spacing="8"
                      style="-fx-padding:14 12 14 12; -fx-background-color:#faf8ff;"/>
            </ScrollPane>

            <!-- Input bar -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color:white;
                         -fx-background-radius:0 0 20 20;
                         -fx-border-color:#ede9fe transparent transparent transparent;
                         -fx-border-width:1 0 0 0;
                         -fx-padding:10 14 14 14;">
                <TextField fx:id="inputField"
                           promptText="Écrivez votre message..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:#f5f3ff;
                                  -fx-background-radius:22;
                                  -fx-border-color:#ddd6fe; -fx-border-radius:22; -fx-border-width:1;
                                  -fx-padding:9 14; -fx-font-size:12;
                                  -fx-text-fill:#1e1b4b;
                                  -fx-prompt-text-fill:#a78bfa;"/>
                <Button fx:id="btnSend" text="▶" onAction="#onSend"
                        style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                               -fx-text-fill:white; -fx-font-size:13; -fx-font-weight:900;
                               -fx-min-width:38; -fx-min-height:38;
                               -fx-max-width:38; -fx-max-height:38;
                               -fx-background-radius:50%;
                               -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.45),8,0,0,2);"/>
            </HBox>
        </VBox>

        <!-- ══════════ FLOATING BUTTON ══════════ -->
        <StackPane alignment="CENTER" pickOnBounds="false">
            <!-- Pulse ring -->
            <Circle radius="34"
                    style="-fx-fill:rgba(124,58,237,0.15);"
                    mouseTransparent="true"/>
            <!-- Main button -->
            <Button fx:id="btnToggle" text="💬" onAction="#onToggle"
                    style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                           -fx-text-fill:white; -fx-font-size:20;
                           -fx-min-width:56; -fx-min-height:56;
                           -fx-max-width:56; -fx-max-height:56;
                           -fx-background-radius:50%;
                           -fx-cursor:hand; -fx-border-width:0;
                           -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.55),18,0,0,5);"
                    alignment="CENTER"/>
        </StackPane>

    </VBox>
</StackPane>
