<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<!-- Floating AI Assistant for Students -->
<StackPane xmlns:fx="http://javafx.com/fxml"
           fx:controller="tn.esprit.controllers.StudentAssistantController"
           alignment="BOTTOM_RIGHT"
           pickOnBounds="false"
           style="-fx-background-color:transparent;">

    <VBox alignment="BOTTOM_RIGHT" spacing="12" pickOnBounds="false"
          style="-fx-padding:0 24 24 0;">

        <!-- Chat Panel -->
        <VBox fx:id="chatPanel" spacing="0"
              style="-fx-background-color:white;
                     -fx-background-radius:24;
                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.25),32,0,0,12);"
              prefWidth="360" prefHeight="520"
              visible="false" managed="false">

            <!-- Header -->
            <HBox alignment="CENTER_LEFT" spacing="12"
                  style="-fx-background-color:linear-gradient(to right,#7c3aed,#4f46e5);
                         -fx-background-radius:24 24 0 0;
                         -fx-padding:16 20 16 20;">

                <!-- AI Avatar -->
                <StackPane minWidth="40" minHeight="40" maxWidth="40" maxHeight="40">
                    <Circle radius="20" style="-fx-fill:rgba(255,255,255,0.2);"/>
                    <Label text="AI"
                           style="-fx-font-size:12; -fx-font-weight:900; -fx-text-fill:white;"/>
                </StackPane>

                <VBox spacing="2">
                    <Label text="Assistant AutoLearn"
                           style="-fx-font-size:14; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <HBox spacing="6" alignment="CENTER_LEFT">
                        <Circle radius="4" style="-fx-fill:#a7f3d0;"/>
                        <Label fx:id="labelStatus" text="🟢 En ligne"
                               style="-fx-font-size:10; -fx-text-fill:rgba(255,255,255,0.85);"/>
                    </HBox>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button text="🗑" onAction="#onClear"
                        style="-fx-background-color:rgba(255,255,255,0.15);
                               -fx-text-fill:white; -fx-font-size:13;
                               -fx-padding:6 10; -fx-background-radius:10;
                               -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Messages -->
            <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                        hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                        style="-fx-background-color:#faf8ff; -fx-background:#faf8ff; -fx-border-width:0;">
                <VBox fx:id="messagesBox" spacing="10"
                      style="-fx-padding:16 14 16 14; -fx-background-color:#faf8ff;"/>
            </ScrollPane>

            <!-- Input -->
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color:white;
                         -fx-background-radius:0 0 24 24;
                         -fx-border-color:#ede9fe transparent transparent transparent;
                         -fx-border-width:1 0 0 0;
                         -fx-padding:12 16 16 16;">
                <TextField fx:id="inputField"
                           promptText="Posez votre question..."
                           HBox.hgrow="ALWAYS"
                           style="-fx-background-color:#f5f3ff;
                                  -fx-background-radius:20;
                                  -fx-border-color:#ede9fe; -fx-border-radius:20; -fx-border-width:1;
                                  -fx-padding:10 16; -fx-font-size:12;
                                  -fx-text-fill:#1e1b4b;
                                  -fx-prompt-text-fill:#c4b5fd;"/>
                <Button fx:id="btnSend" text="➤" onAction="#onSend"
                        style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                               -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:900;
                               -fx-min-width:42; -fx-min-height:42;
                               -fx-max-width:42; -fx-max-height:42;
                               -fx-background-radius:50%;
                               -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.5),10,0,0,3);"/>
            </HBox>
        </VBox>

        <!-- Floating Toggle Button -->
        <Button fx:id="btnToggle" text="💬" onAction="#onToggle"
                style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                       -fx-text-fill:white; -fx-font-size:22;
                       -fx-min-width:60; -fx-min-height:60;
                       -fx-max-width:60; -fx-max-height:60;
                       -fx-background-radius:50%;
                       -fx-cursor:hand; -fx-border-width:0;
                       -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.6),20,0,0,6);"
                alignment="CENTER"/>

    </VBox>
</StackPane>
