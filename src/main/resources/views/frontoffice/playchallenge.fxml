<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="tn.esprit.controllers.PlayChallengeController"
            maxHeight="Infinity" maxWidth="Infinity"
            style="-fx-background-color: linear-gradient(to bottom right, #7c3aed, #a78bfa);">

    <!-- ================= TOP ================= -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12"
              style="-fx-padding:14 24 14 24; -fx-background-color:rgba(0,0,0,0.25);">

            <Label text="🎓 Challenge"
                   style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:700;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <Label fx:id="timerLabel" text="⏱  00:00"
                   style="-fx-background-color:linear-gradient(to right,#f59e0b,#d97706);
                          -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:800;
                          -fx-padding:6 18 6 18; -fx-background-radius:20;"/>

            <Button text="✖ Quitter" onAction="#onQuit"
                    style="-fx-background-color:rgba(255,255,255,0.2); -fx-text-fill:white;
                           -fx-font-size:13; -fx-font-weight:700; -fx-background-radius:20;
                           -fx-min-width:90; -fx-min-height:36; -fx-cursor:hand;
                           -fx-border-width:0;"/>
        </HBox>
    </top>

    <!-- ================= CENTER ================= -->
    <center>
        <VBox alignment="CENTER" spacing="25"
              style="-fx-padding:0 40 0 40; -fx-background-color:transparent;">

            <Region VBox.vgrow="ALWAYS" maxHeight="80"/>

            <!-- Citation motivante -->
            <VBox spacing="8" alignment="CENTER">
                <Label fx:id="quoteLabel" text=""
                       style="-fx-font-size:14; -fx-font-style:italic; -fx-text-fill:white;
                              -fx-background-color:rgba(255,255,255,0.15); -fx-background-radius:15;
                              -fx-padding:12 24 12 24; -fx-wrap-text:true; -fx-text-alignment:CENTER;
                              -fx-font-weight:600;"
                       wrapText="true" alignment="CENTER" maxWidth="700"/>
            </VBox>

            <!-- Carte Question -->
            <VBox alignment="CENTER" spacing="16"
                  style="-fx-background-color:white; -fx-background-radius:16;
                         -fx-padding:32 40 32 40;
                         -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),20,0,0,6);">

                <Label fx:id="progressLabel" text="Question 1 / 1"
                       style="-fx-text-fill:#94a3b8; -fx-font-size:12; -fx-font-weight:700;"/>

                <!-- Type badge -->
                <Label fx:id="typeBadge" text=""
                       style="-fx-font-size:13; -fx-font-weight:800; -fx-padding:6 18 6 18;
                              -fx-background-radius:20;"/>

                <!-- En-tête de la question avec bouton de traduction -->
                <HBox alignment="CENTER_LEFT" spacing="12" maxWidth="700">
                    <Label text="❓"
                           style="-fx-font-size:20;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <ComboBox fx:id="langCombo" prefWidth="130" promptText="Langue"
                              style="-fx-background-color:white; -fx-border-color:#e2e8f0;
                                     -fx-border-radius:10; -fx-background-radius:10;
                                     -fx-padding:5 10 5 10; -fx-font-size:12; -fx-font-weight:600;"/>
                    <Button fx:id="translateBtn" text="🌐 Traduire" onAction="#onTranslate"
                            style="-fx-background-color:rgba(124,58,237,0.12); -fx-text-fill:#7c3aed;
                                   -fx-font-size:12; -fx-font-weight:700; -fx-padding:6 16 6 16;
                                   -fx-background-radius:20; -fx-cursor:hand; -fx-border-width:0;"/>
                </HBox>

                <Label fx:id="questionLabel" text=""
                       style="-fx-font-size:20; -fx-font-weight:900; -fx-text-fill:#0f172a;
                              -fx-text-alignment:CENTER;"
                       wrapText="true" maxWidth="700" alignment="CENTER"/>

                <!-- Label pour afficher la traduction -->
                <Label fx:id="translatedLabel" text="" wrapText="true" visible="false" managed="false"
                       style="-fx-font-size:14; -fx-text-fill:#7c3aed; -fx-font-style:italic;
                              -fx-background-color:rgba(124,58,237,0.08); -fx-background-radius:12;
                              -fx-padding:14; -fx-border-color:#7c3aed; -fx-border-radius:12;
                              -fx-border-width:1.5;"
                       maxWidth="700"/>

                <!-- Champ texte pour les exercices -->
                <TextField fx:id="answerField" promptText="Tapez votre réponse ici..."
                           style="-fx-background-color:#f9fafb; -fx-border-color:#e2e8f0;
                                  -fx-border-radius:12; -fx-background-radius:12;
                                  -fx-padding:16 20 16 20; -fx-font-size:14; -fx-border-width:1.5;
                                  -fx-prompt-text-fill:#94a3b8;"
                           maxWidth="700"/>

                <Label fx:id="pointsLabel" text="⭐ 10 points"
                       style="-fx-font-size:13; -fx-text-fill:#f59e0b; -fx-font-weight:700;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

        </VBox>
    </center>

    <!-- ================= BOTTOM ================= -->
    <bottom>
        <VBox spacing="0">

            <!-- Barre de progression -->
            <StackPane prefHeight="10">
                <Region style="-fx-background-color:rgba(255,255,255,0.15); -fx-pref-height:10;"/>
                <ProgressBar fx:id="progressBar" progress="0.0"
                             prefHeight="10" maxWidth="Infinity"
                             style="-fx-accent:#22c55e; -fx-background-color:transparent;"/>
            </StackPane>

            <!-- Boutons navigation -->
            <HBox alignment="CENTER" spacing="16"
                  style="-fx-padding:12 28 12 28; -fx-background-color:rgba(0,0,0,0.35); -fx-min-height:70;">

                <Button fx:id="prevButton" text="❮" onAction="#onPrev"
                        minWidth="44" minHeight="44"
                        style="-fx-background-color:rgba(255,255,255,0.25); -fx-text-fill:white;
                               -fx-font-size:18; -fx-font-weight:900; -fx-background-radius:50%;"/>

                <Button fx:id="nextButton" text="❯" onAction="#onNext"
                        minWidth="44" minHeight="44"
                        style="-fx-background-color:rgba(255,255,255,0.25); -fx-text-fill:white;
                               -fx-font-size:18; -fx-font-weight:900; -fx-background-radius:50%;"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="finishButton" text="✔   Terminer le Challenge"
                        onAction="#onFinish"
                        minWidth="220" minHeight="45"
                        visible="false" managed="false"
                        style="-fx-background-color:linear-gradient(to right,#22c55e,#16a34a);
                               -fx-text-fill:white;
                               -fx-font-size:14; -fx-font-weight:700;
                               -fx-padding:10 24 10 24;
                               -fx-background-radius:24;">
                    <HBox.margin>
                        <Insets bottom="8"/>
                    </HBox.margin>
                </Button>

            </HBox>

        </VBox>
    </bottom>


    <!-- -- EXTRA BOTTOM SPACE FOR SCROLLING -- -->
    <Region prefHeight="150" />

</BorderPane>