<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Ellipse?>

<!-- Conteneur racine : fond violet dégradé -->
<StackPane xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.controllers.FrontQuizController"
           style="-fx-background-color: linear-gradient(to bottom right, #7c3aed, #a78bfa);">

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- COUCHE 1 : Éléments décoratifs de fond (cercles + formes)  -->
    <!-- ═══════════════════════════════════════════════════════════ -->

    <!-- ── Grands cercles pleins ── -->
    <Circle radius="200" fill="rgba(255,255,255,0.06)" translateX="-340" translateY="-200"/>
    <Circle radius="170" fill="rgba(255,255,255,0.05)" translateX="360"  translateY="-190"/>
    <Circle radius="150" fill="rgba(255,255,255,0.07)" translateX="-380" translateY="230"/>
    <Circle radius="180" fill="rgba(255,255,255,0.04)" translateX="370"  translateY="220"/>
    <Circle radius="130" fill="rgba(255,255,255,0.06)" translateX="0"    translateY="-260"/>
    <Circle radius="100" fill="rgba(255,255,255,0.05)" translateX="-100" translateY="280"/>
    <Circle radius="110" fill="rgba(255,255,255,0.06)" translateX="200"  translateY="260"/>

    <!-- ── Cercles moyens ── -->
    <Circle radius="75"  fill="rgba(255,255,255,0.08)" translateX="180"  translateY="-230"/>
    <Circle radius="65"  fill="rgba(255,255,255,0.09)" translateX="-280" translateY="60"/>
    <Circle radius="60"  fill="rgba(255,255,255,0.07)" translateX="280"  translateY="100"/>
    <Circle radius="55"  fill="rgba(255,255,255,0.08)" translateX="-180" translateY="-100"/>
    <Circle radius="50"  fill="rgba(255,255,255,0.07)" translateX="150"  translateY="230"/>
    <Circle radius="45"  fill="rgba(255,255,255,0.09)" translateX="-350" translateY="-50"/>
    <Circle radius="40"  fill="rgba(255,255,255,0.08)" translateX="350"  translateY="-50"/>
    <Circle radius="35"  fill="rgba(255,255,255,0.10)" translateX="0"    translateY="200"/>
    <Circle radius="30"  fill="rgba(255,255,255,0.09)" translateX="-150" translateY="-200"/>
    <Circle radius="28"  fill="rgba(255,255,255,0.08)" translateX="320"  translateY="-220"/>

    <!-- ── Anneaux (cercles vides avec contour) ── -->
    <Circle radius="120" fill="transparent" stroke="rgba(255,255,255,0.10)" strokeWidth="2"
            translateX="-250" translateY="180"/>
    <Circle radius="90"  fill="transparent" stroke="rgba(255,255,255,0.12)" strokeWidth="2"
            translateX="260"  translateY="-150"/>
    <Circle radius="70"  fill="transparent" stroke="rgba(255,255,255,0.09)" strokeWidth="1.5"
            translateX="-100" translateY="-220"/>
    <Circle radius="55"  fill="transparent" stroke="rgba(255,255,255,0.14)" strokeWidth="1.5"
            translateX="320"  translateY="150"/>
    <Circle radius="40"  fill="transparent" stroke="rgba(255,255,255,0.12)" strokeWidth="1"
            translateX="80"   translateY="270"/>
    <Circle radius="35"  fill="transparent" stroke="rgba(255,255,255,0.10)" strokeWidth="1"
            translateX="-300" translateY="-240"/>

    <!-- ── Rectangles arrondis inclinés ── -->
    <Rectangle width="90"  height="90"  arcWidth="22" arcHeight="22"
               fill="rgba(255,255,255,0.06)" rotate="30"  translateX="-300" translateY="-120"/>
    <Rectangle width="70"  height="70"  arcWidth="16" arcHeight="16"
               fill="rgba(255,255,255,0.07)" rotate="45"  translateX="310"  translateY="170"/>
    <Rectangle width="55"  height="55"  arcWidth="12" arcHeight="12"
               fill="rgba(255,255,255,0.06)" rotate="20"  translateX="200"  translateY="-180"/>
    <Rectangle width="45"  height="45"  arcWidth="10" arcHeight="10"
               fill="rgba(255,255,255,0.08)" rotate="60"  translateX="-200" translateY="220"/>
    <Rectangle width="35"  height="35"  arcWidth="8"  arcHeight="8"
               fill="rgba(255,255,255,0.09)" rotate="15"  translateX="100"  translateY="260"/>
    <Rectangle width="30"  height="30"  arcWidth="7"  arcHeight="7"
               fill="rgba(255,255,255,0.07)" rotate="75"  translateX="-350" translateY="200"/>

    <!-- ── Ellipses ── -->
    <Ellipse radiusX="220" radiusY="65" fill="rgba(255,255,255,0.04)" translateX="0"    translateY="290"/>
    <Ellipse radiusX="150" radiusY="50" fill="rgba(255,255,255,0.05)" translateX="-150" translateY="-270"/>
    <Ellipse radiusX="110" radiusY="38" fill="rgba(255,255,255,0.06)" translateX="300"  translateY="260"/>
    <Ellipse radiusX="80"  radiusY="30" fill="rgba(255,255,255,0.07)" translateX="-320" translateY="100"/>

    <!-- ── Points lumineux dispersés ── -->
    <Circle radius="7" fill="rgba(255,255,255,0.28)" translateX="-200" translateY="-260"/>
    <Circle radius="5" fill="rgba(255,255,255,0.22)" translateX="250"  translateY="-100"/>
    <Circle radius="6" fill="rgba(255,255,255,0.25)" translateX="-150" translateY="200"/>
    <Circle radius="8" fill="rgba(255,255,255,0.20)" translateX="200"  translateY="250"/>
    <Circle radius="5" fill="rgba(255,255,255,0.28)" translateX="100"  translateY="-280"/>
    <Circle radius="6" fill="rgba(255,255,255,0.22)" translateX="-320" translateY="150"/>
    <Circle radius="4" fill="rgba(255,255,255,0.35)" translateX="380"  translateY="50"/>
    <Circle radius="5" fill="rgba(255,255,255,0.25)" translateX="-80"  translateY="270"/>
    <Circle radius="4" fill="rgba(255,255,255,0.30)" translateX="320"  translateY="-260"/>
    <Circle radius="6" fill="rgba(255,255,255,0.22)" translateX="-340" translateY="-260"/>
    <Circle radius="3" fill="rgba(255,255,255,0.40)" translateX="60"   translateY="-290"/>
    <Circle radius="4" fill="rgba(255,255,255,0.30)" translateX="-60"  translateY="290"/>
    <Circle radius="5" fill="rgba(255,255,255,0.25)" translateX="240"  translateY="180"/>
    <Circle radius="3" fill="rgba(255,255,255,0.35)" translateX="-240" translateY="-180"/>
    <Circle radius="4" fill="rgba(255,255,255,0.28)" translateX="160"  translateY="-160"/>
    <Circle radius="5" fill="rgba(255,255,255,0.22)" translateX="-160" translateY="160"/>
    <Circle radius="3" fill="rgba(255,255,255,0.38)" translateX="340"  translateY="100"/>
    <Circle radius="4" fill="rgba(255,255,255,0.30)" translateX="-340" translateY="-100"/>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- COUCHE 2 : Bouton retour en haut à gauche                  -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox alignment="TOP_LEFT" style="-fx-background-color:transparent;">
        <HBox style="-fx-padding:18 0 0 18;">
            <Button text="← Retour aux chapitres" onAction="#onRetour"
                    style="-fx-background-color:rgba(255,255,255,0.18); -fx-text-fill:white;
                           -fx-font-size:13; -fx-font-weight:700; -fx-padding:9 18 9 18;
                           -fx-background-radius:22; -fx-cursor:hand; -fx-border-width:0;
                           -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);"/>
        </HBox>
    </VBox>

    <!-- ═══════════════════════════════════════════════════════════ -->
    <!-- COUCHE 3 : Carte blanche centrale                          -->
    <!-- ═══════════════════════════════════════════════════════════ -->
    <VBox alignment="CENTER" spacing="0" maxWidth="460" maxHeight="440"
          style="-fx-background-color:white; -fx-background-radius:24;
                 -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.30),40,0,0,12);">
        <padding><Insets top="36" right="36" bottom="36" left="36"/></padding>

        <!-- Icône décorative rouge en haut de la carte -->
        <HBox alignment="CENTER" style="-fx-padding:0 0 16 0;">
            <Label text="📱"
                   style="-fx-font-size:36; -fx-background-color:#e53935;
                          -fx-background-radius:16; -fx-padding:14 16 14 16;
                          -fx-text-fill:white;
                          -fx-effect:dropshadow(gaussian,rgba(229,57,53,0.4),12,0,0,4);"/>
        </HBox>

        <!-- Titre du quiz -->
        <Label fx:id="labelTitreQuiz" text="Quiz"
               style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#0f172a;
                      -fx-text-alignment:CENTER;"
               wrapText="true" maxWidth="380"/>

        <!-- Description du quiz -->
        <Label fx:id="labelDescQuiz" text=""
               style="-fx-font-size:13; -fx-text-fill:#7c3aed; -fx-text-alignment:CENTER;
                      -fx-padding:6 0 20 0;"
               wrapText="true" maxWidth="380"/>

        <!-- Bande de statistiques : 3 colonnes -->
        <HBox spacing="0" alignment="CENTER"
              style="-fx-background-color:#f8fafc; -fx-background-radius:14;
                     -fx-border-color:#e2e8f0; -fx-border-radius:14;
                     -fx-padding:18 0 18 0; -fx-min-width:360;">

            <!-- Questions -->
            <VBox alignment="CENTER" spacing="6" prefWidth="120">
                <Label text="❓"
                       style="-fx-font-size:22; -fx-background-color:#ef4444;
                              -fx-background-radius:50%; -fx-padding:6 8 6 8;"/>
                <Label fx:id="labelNbQuestions" text="0"
                       style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#0f172a;"/>
                <Label text="QUESTIONS"
                       style="-fx-font-size:10; -fx-text-fill:#94a3b8; -fx-font-weight:700;"/>
            </VBox>

            <!-- Points -->
            <VBox alignment="CENTER" spacing="6" prefWidth="120">
                <Label text="⭐"
                       style="-fx-font-size:22; -fx-background-color:#f59e0b;
                              -fx-background-radius:50%; -fx-padding:6 8 6 8;"/>
                <Label fx:id="labelTotalPoints" text="0"
                       style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#0f172a;"/>
                <Label text="POINTS"
                       style="-fx-font-size:10; -fx-text-fill:#94a3b8; -fx-font-weight:700;"/>
            </VBox>

            <!-- Minutes -->
            <VBox alignment="CENTER" spacing="6" prefWidth="120">
                <Label text="⏱"
                       style="-fx-font-size:22; -fx-background-color:#3b82f6;
                              -fx-background-radius:50%; -fx-padding:6 8 6 8;"/>
                <Label fx:id="labelDuree" text="—"
                       style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:#0f172a;"/>
                <Label text="MINUTES"
                       style="-fx-font-size:10; -fx-text-fill:#94a3b8; -fx-font-weight:700;"/>
            </VBox>
        </HBox>

        <!-- Bouton commencer -->
        <Button text="▶   Commencer le quiz" onAction="#onCommencer"
                maxWidth="Infinity"
                style="-fx-background-color:linear-gradient(to right,#22c55e,#16a34a);
                       -fx-text-fill:white; -fx-font-size:15; -fx-font-weight:800;
                       -fx-padding:14 0 14 0; -fx-background-radius:30;
                       -fx-cursor:hand; -fx-border-width:0;
                       -fx-effect:dropshadow(gaussian,rgba(34,197,94,0.5),14,0,0,5);">
            <VBox.margin><Insets top="22"/></VBox.margin>
        </Button>
    </VBox>

</StackPane>
