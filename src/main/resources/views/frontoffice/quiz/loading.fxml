<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Circle?>

<StackPane fx:id="rootPane"
           xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="tn.esprit.controllers.FrontQuizController"
           style="-fx-background-color: linear-gradient(to bottom right, #7c3aed, #a78bfa);"
           prefWidth="1000" prefHeight="700">

    <!-- ── Décorations de fond (bulles) — même style que intro/sélection ── -->

    <!-- Grands cercles pleins -->
    <Circle radius="200" fill="rgba(255,255,255,0.06)" translateX="-380" translateY="-200" mouseTransparent="true"/>
    <Circle radius="170" fill="rgba(255,255,255,0.05)" translateX="380"  translateY="-190" mouseTransparent="true"/>
    <Circle radius="150" fill="rgba(255,255,255,0.07)" translateX="-370" translateY="230"  mouseTransparent="true"/>
    <Circle radius="180" fill="rgba(255,255,255,0.04)" translateX="370"  translateY="220"  mouseTransparent="true"/>
    <Circle radius="130" fill="rgba(255,255,255,0.06)" translateX="0"    translateY="-270" mouseTransparent="true"/>
    <Circle radius="100" fill="rgba(255,255,255,0.05)" translateX="-100" translateY="290"  mouseTransparent="true"/>
    <Circle radius="110" fill="rgba(255,255,255,0.06)" translateX="200"  translateY="270"  mouseTransparent="true"/>

    <!-- Cercles moyens -->
    <Circle radius="75"  fill="rgba(255,255,255,0.08)" translateX="180"  translateY="-240" mouseTransparent="true"/>
    <Circle radius="65"  fill="rgba(255,255,255,0.09)" translateX="-280" translateY="70"   mouseTransparent="true"/>
    <Circle radius="60"  fill="rgba(255,255,255,0.07)" translateX="280"  translateY="110"  mouseTransparent="true"/>
    <Circle radius="55"  fill="rgba(255,255,255,0.08)" translateX="-180" translateY="-110" mouseTransparent="true"/>
    <Circle radius="50"  fill="rgba(255,255,255,0.07)" translateX="150"  translateY="240"  mouseTransparent="true"/>
    <Circle radius="45"  fill="rgba(255,255,255,0.09)" translateX="-350" translateY="-60"  mouseTransparent="true"/>
    <Circle radius="40"  fill="rgba(255,255,255,0.08)" translateX="350"  translateY="-60"  mouseTransparent="true"/>
    <Circle radius="35"  fill="rgba(255,255,255,0.10)" translateX="0"    translateY="210"  mouseTransparent="true"/>
    <Circle radius="30"  fill="rgba(255,255,255,0.09)" translateX="-150" translateY="-210" mouseTransparent="true"/>
    <Circle radius="28"  fill="rgba(255,255,255,0.08)" translateX="320"  translateY="-230" mouseTransparent="true"/>

    <!-- Anneaux -->
    <Circle radius="120" fill="transparent" stroke="rgba(255,255,255,0.10)" strokeWidth="2"   translateX="-250" translateY="190"  mouseTransparent="true"/>
    <Circle radius="90"  fill="transparent" stroke="rgba(255,255,255,0.12)" strokeWidth="2"   translateX="260"  translateY="-160" mouseTransparent="true"/>
    <Circle radius="70"  fill="transparent" stroke="rgba(255,255,255,0.09)" strokeWidth="1.5" translateX="-100" translateY="-230" mouseTransparent="true"/>
    <Circle radius="55"  fill="transparent" stroke="rgba(255,255,255,0.14)" strokeWidth="1.5" translateX="320"  translateY="160"  mouseTransparent="true"/>

    <!-- Points lumineux -->
    <Circle radius="7" fill="rgba(255,255,255,0.28)" translateX="-210" translateY="-270" mouseTransparent="true"/>
    <Circle radius="5" fill="rgba(255,255,255,0.22)" translateX="260"  translateY="-110" mouseTransparent="true"/>
    <Circle radius="6" fill="rgba(255,255,255,0.25)" translateX="-160" translateY="210"  mouseTransparent="true"/>
    <Circle radius="8" fill="rgba(255,255,255,0.20)" translateX="210"  translateY="260"  mouseTransparent="true"/>
    <Circle radius="5" fill="rgba(255,255,255,0.28)" translateX="110"  translateY="-290" mouseTransparent="true"/>
    <Circle radius="6" fill="rgba(255,255,255,0.22)" translateX="-330" translateY="160"  mouseTransparent="true"/>
    <Circle radius="4" fill="rgba(255,255,255,0.35)" translateX="390"  translateY="60"   mouseTransparent="true"/>
    <Circle radius="5" fill="rgba(255,255,255,0.25)" translateX="-80"  translateY="280"  mouseTransparent="true"/>
    <Circle radius="4" fill="rgba(255,255,255,0.30)" translateX="320"  translateY="-270" mouseTransparent="true"/>
    <Circle radius="3" fill="rgba(255,255,255,0.40)" translateX="60"   translateY="-300" mouseTransparent="true"/>
    <Circle radius="4" fill="rgba(255,255,255,0.30)" translateX="-60"  translateY="300"  mouseTransparent="true"/>
    <Circle radius="5" fill="rgba(255,255,255,0.25)" translateX="240"  translateY="190"  mouseTransparent="true"/>
    <Circle radius="3" fill="rgba(255,255,255,0.35)" translateX="-240" translateY="-190" mouseTransparent="true"/>

    <!-- ── Contenu centré ── -->
    <VBox alignment="CENTER" spacing="24">

        <!-- Logo 4 carrés animés -->
        <StackPane fx:id="logoContainer" prefWidth="120" prefHeight="120">
            <Rectangle fx:id="squareBlue"
                       width="55" height="55" arcWidth="12" arcHeight="12"
                       fill="#3498db" translateX="-28" translateY="-28"/>
            <Rectangle fx:id="squareGreen"
                       width="55" height="55" arcWidth="12" arcHeight="12"
                       fill="#2ecc71" translateX="28" translateY="-28"/>
            <Rectangle fx:id="squareRed"
                       width="55" height="55" arcWidth="12" arcHeight="12"
                       fill="#e74c3c" translateX="-28" translateY="28"/>
            <Rectangle fx:id="squareOrange"
                       width="55" height="55" arcWidth="12" arcHeight="12"
                       fill="#f39c12" translateX="28" translateY="28"/>
        </StackPane>

        <!-- Texte principal -->
        <Label fx:id="loadingLabel" text="Chargement du Quiz..."
               style="-fx-text-fill:white; -fx-font-size:28; -fx-font-weight:bold;"/>

        <!-- Nom du quiz -->
        <Label fx:id="quizNameLabel" text=""
               style="-fx-text-fill:rgba(255,255,255,0.8); -fx-font-size:16;"/>

    </VBox>

</StackPane>

