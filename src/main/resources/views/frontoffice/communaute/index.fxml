<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.FrontCommunauteController"
      style="-fx-background-color:linear-gradient(to bottom,#f7f7ff,#f2f4ff);">
    <top>
        <fx:include source="../../components/navbar_front.fxml" fx:id="navbar"/>
    </top>
    <center>
    <VBox spacing="0" style="-fx-background-color:transparent;">

    <!-- Header -->
    <VBox alignment="CENTER" spacing="12" prefHeight="220"
          style="-fx-background-color: #7a6ad8; -fx-padding: 40 80;">
        <Label text="👥  Communautés"
               style="-fx-font-size:32; -fx-font-weight:800; -fx-text-fill:white;"/>
        <Label text="Un espace dynamique pour échanger, poster et grandir ensemble"
               style="-fx-font-size:14; -fx-font-weight:600; -fx-text-fill:rgba(255,255,255,0.82);"/>
        <HBox alignment="CENTER" spacing="12">
            <TextField fx:id="searchField" promptText="🔍  Rechercher une communauté..."
                       prefWidth="380"
                       style="-fx-background-color: white; -fx-text-fill: #1f1a42;
                              -fx-prompt-text-fill: #94a3b8; -fx-background-radius: 12;
                              -fx-border-color: #e2e8f0; -fx-border-radius: 12; -fx-border-width: 1;
                              -fx-padding: 12 20; -fx-font-size: 14;"/>
            <Button text="＋  Créer une communauté" onAction="#onCreer"
                    style="-fx-background-color: #ffd43b; -fx-text-fill: #1f1a42; -fx-font-weight: 800;
                           -fx-font-size: 14; -fx-padding: 12 24; -fx-background-radius: 12;
                           -fx-cursor: hand; -fx-border-width: 0;
                           -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.1), 10, 0, 0, 3);"/>
        </HBox>
    </VBox>

    <!-- Cards grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-width:0;">
        <VBox style="-fx-padding:36 80 36 80;" spacing="0">
            <FlowPane fx:id="cardsPane" hgap="24" vgap="24"
                      style="-fx-background-color:transparent;"/>
            <Label fx:id="emptyLabel" text="Aucune communauté disponible."
                   style="-fx-text-fill:#8d88b4; -fx-font-size:14; -fx-padding:16 0 0 0;" visible="false"/>
        </VBox>
    </ScrollPane>
</VBox>
    </center>
</BorderPane>
