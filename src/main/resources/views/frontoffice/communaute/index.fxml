<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.FrontCommunauteController"
      style="-fx-background-color:#f0eeff;">
    <center>
    <VBox spacing="0" style="-fx-background-color:#f0eeff;">

    <!-- Header -->
    <StackPane minHeight="240" maxHeight="240">
        <VBox style="-fx-background-color:linear-gradient(to bottom right,#6d28d9,#7c3aed,#4f46e5,#818cf8);
                     -fx-min-height:240; -fx-max-height:240;"/>
        <VBox style="-fx-background-color:rgba(255,255,255,0.04); -fx-min-height:240; -fx-max-height:240;"/>
        <Circle radius="200" fill="rgba(255,255,255,0.04)" translateX="-380" translateY="-30"/>
        <Circle radius="120" fill="rgba(255,255,255,0.05)" translateX="340"  translateY="50"/>
        <Circle radius="60"  fill="rgba(255,255,255,0.07)" translateX="80"   translateY="-80"/>

        <VBox alignment="CENTER" spacing="18" style="-fx-padding:40 80;">
            <Label text="👥  Communautés"
                   style="-fx-font-size:36; -fx-font-weight:900; -fx-text-fill:white;
                          -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.2),8,0,0,3);"/>
            <Label text="Un espace dynamique pour échanger, poster et grandir ensemble"
                   style="-fx-font-size:14; -fx-font-weight:500; -fx-text-fill:rgba(255,255,255,0.68);"/>
            <HBox alignment="CENTER" spacing="14">
                <TextField fx:id="searchField" promptText="🔍  Rechercher une communauté..."
                           prefWidth="400"
                           style="-fx-background-color:rgba(255,255,255,0.16); -fx-text-fill:white;
                                  -fx-prompt-text-fill:rgba(255,255,255,0.45); -fx-background-radius:30;
                                  -fx-border-color:rgba(255,255,255,0.25); -fx-border-radius:30; -fx-border-width:1.5;
                                  -fx-padding:13 24; -fx-font-size:13;"/>
                <Button text="＋  Créer" onAction="#onCreer"
                        style="-fx-background-color:white;
                               -fx-text-fill:#7c3aed; -fx-font-weight:900;
                               -fx-font-size:13; -fx-padding:13 30; -fx-background-radius:30;
                               -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.18),14,0,0,5);"/>
            </HBox>
        </VBox>
    </StackPane>

    <!-- Cards grid -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                style="-fx-background-color:#f0eeff; -fx-background:#f0eeff; -fx-border-width:0;">
        <VBox style="-fx-padding:38 80 52 80; -fx-background-color:#f0eeff;" spacing="0">
            <FlowPane fx:id="cardsPane" hgap="26" vgap="26"
                      style="-fx-background-color:transparent;"/>
            <Label fx:id="emptyLabel" text="Aucune communauté disponible."
                   style="-fx-text-fill:#c4b5fd; -fx-font-size:14; -fx-padding:20 0 0 0;" visible="false"/>
        </VBox>
    </ScrollPane>
</VBox>
    </center>
</BorderPane>
