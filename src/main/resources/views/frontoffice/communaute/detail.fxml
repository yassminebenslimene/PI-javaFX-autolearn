<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.FrontCommunauteDetailController"
      style="-fx-background-color:linear-gradient(to bottom,#f5f8ff,#eef3ff);">
    <top>
        <fx:include source="../../components/navbar_front.fxml" fx:id="navbar"/>
    </top>
    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-width:0;">
            <VBox spacing="0" style="-fx-background-color:transparent;">

            <!-- Hero communauté -->
            <VBox spacing="14" style="-fx-background-color: #7a6ad8;
                                       -fx-padding: 30 70;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="← Retour" onAction="#onRetour"
                            style="-fx-background-color:rgba(255,255,255,0.16); -fx-text-fill:white;
                                   -fx-font-size:12; -fx-font-weight:700; -fx-padding:7 16 7 16; -fx-background-radius:20;
                                   -fx-cursor:hand; -fx-border-color:rgba(255,255,255,0.25); -fx-border-radius:20; -fx-border-width:1;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnGererMembres" text="👥  Gérer les membres" onAction="#onGererMembres"
                            visible="false" managed="false"
                            style="-fx-background-color: white; -fx-text-fill: #7a6ad8;
                                   -fx-font-size: 12; -fx-font-weight: 800; -fx-padding: 8 18;
                                   -fx-background-radius: 10; -fx-cursor: hand; -fx-border-width: 0;"/>
                </HBox>

                <Label fx:id="labelNom" text=""
                       style="-fx-font-size:34; -fx-font-weight:800; -fx-text-fill:white;"/>
                <Label fx:id="labelDescription" text="" wrapText="true"
                       style="-fx-font-size:14; -fx-font-weight:600; -fx-text-fill:rgba(255,255,255,0.85);"/>

                <HBox spacing="12">
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 12;
                                 -fx-padding: 8 16;">
                        <Label text="⚡" style="-fx-font-size: 14;"/>
                        <Label text="Communauté active" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 700;"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="8"
                          style="-fx-background-color: rgba(255,255,255,0.1); -fx-background-radius: 12;
                                 -fx-padding: 8 16;">
                        <Label text="🧠" style="-fx-font-size: 14;"/>
                        <Label text="Partagez vos idées" style="-fx-text-fill: white; -fx-font-size: 13; -fx-font-weight: 700;"/>
                    </HBox>
                </HBox>

                <HBox spacing="10">
                    <Label text="Activite elevee"
                           style="-fx-background-color: #22c55e; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 800;
                                  -fx-padding: 6 12; -fx-background-radius: 8;"/>
                    <Label text="Discussions en temps reel"
                           style="-fx-background-color: #3b82f6; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 800;
                                  -fx-padding: 6 12; -fx-background-radius: 8;"/>
                    <Label text="Communaute engagee"
                           style="-fx-background-color: #ec4899; -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: 800;
                                  -fx-padding: 6 12; -fx-background-radius: 8;"/>
                </HBox>
            </VBox>

            <!-- Zone contenu -->
            <HBox spacing="20" VBox.vgrow="ALWAYS" style="-fx-padding: 26 70; -fx-background-color: #f8fafc;">

                <!-- Colonne principale -->
                <VBox spacing="16" HBox.hgrow="ALWAYS">
                    <VBox spacing="12" style="-fx-background-color: white; -fx-background-radius: 16;
                                               -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;
                                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 20, 0, 0, 5);
                                               -fx-padding: 24;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Creer une publication" style="-fx-font-size:16; -fx-font-weight:800; -fx-text-fill:#0f172a;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label text="Partagez avec votre communaute" style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:#64748b;"/>
                        </HBox>
                        <TextField fx:id="fieldTitre" promptText="Titre de votre publication..."
                                   style="-fx-background-color: #f1f5f9; -fx-background-radius: 12;
                                          -fx-border-width: 0; -fx-padding: 12 16; -fx-font-size: 14;"/>
                        <TextArea fx:id="fieldContenu" promptText="Que voulez-vous partager avec la communauté ?" prefRowCount="4"
                                  style="-fx-background-color: #f1f5f9; -fx-background-radius: 12;
                                         -fx-border-width: 0; -fx-padding: 12 16; -fx-font-size: 14;"/>
                        <HBox alignment="CENTER_RIGHT">
                            <Button text="🚀  Publier" onAction="#onPublier"
                                    style="-fx-background-color: #7a6ad8; -fx-text-fill: white; -fx-font-weight: 800;
                                           -fx-font-size: 14; -fx-padding: 12 32; -fx-background-radius: 12;
                                           -fx-cursor: hand; -fx-border-width: 0;
                                           -fx-effect: dropshadow(gaussian, rgba(122,106,216,0.3), 10, 0, 0, 3);"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="16" style="-fx-background-color: white; -fx-background-radius: 16;
                                               -fx-border-color: #e2e8f0; -fx-border-radius: 16; -fx-border-width: 1;
                                               -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.04), 20, 0, 0, 5);
                                               -fx-padding: 24;">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="Fil d'actualite" style="-fx-font-size:18; -fx-font-weight:800; -fx-text-fill:#111827;"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <HBox spacing="6" alignment="CENTER_LEFT">
                                <Label text="Tous"
                                       style="-fx-background-color:#dbeafe; -fx-text-fill:#1e40af; -fx-font-size:11; -fx-font-weight:700;
                                              -fx-padding:5 10 5 10; -fx-background-radius:14;"/>
                                <Label text="Recents"
                                       style="-fx-background-color:#f1f5f9; -fx-text-fill:#475569; -fx-font-size:11; -fx-font-weight:700;
                                              -fx-padding:5 10 5 10; -fx-background-radius:14;"/>
                                <Label text="Populaires"
                                       style="-fx-background-color:#f1f5f9; -fx-text-fill:#475569; -fx-font-size:11; -fx-font-weight:700;
                                              -fx-padding:5 10 5 10; -fx-background-radius:14;"/>
                            </HBox>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Button text="🔄  Rafraîchir" onAction="#onRefresh"
                                    style="-fx-background-color: white; -fx-text-fill: #7a6ad8;
                                           -fx-font-size: 13; -fx-font-weight: 800; -fx-cursor: hand;
                                           -fx-border-color: #7a6ad8; -fx-border-radius: 10; -fx-border-width: 1.5;
                                           -fx-padding: 8 18; -fx-background-radius: 10;"/>
                        </HBox>
                        <VBox fx:id="postsPane" spacing="16"
                               style="-fx-padding: 4; -fx-background-color: transparent;"/>
                    </VBox>
                </VBox>

                <!-- Sidebar -->
                <VBox spacing="14" prefWidth="280">
                    <VBox spacing="8" style="-fx-background-color:linear-gradient(to bottom,#ffffff,#fcfbff); -fx-background-radius:16;
                                              -fx-border-color:#e8e6fb; -fx-border-radius:16; -fx-border-width:1;
                                              -fx-effect:dropshadow(gaussian,rgba(58,46,116,0.10),10,0,0,3);
                                              -fx-padding:16;">
                        <Label text="Conseils pour un post impactant" style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:#1f1a42;"/>
                        <Label wrapText="true" text="Donnez un titre clair. Soyez precis dans votre question. Ajoutez du contexte utile. Restez bienveillant avec la communaute."
                               style="-fx-font-size:12; -fx-text-fill:#5d587f;"/>
                    </VBox>

                    <VBox spacing="8" style="-fx-background-color:linear-gradient(to bottom,#ffffff,#fcfbff); -fx-background-radius:16;
                                              -fx-border-color:#e8e6fb; -fx-border-radius:16; -fx-border-width:1;
                                              -fx-effect:dropshadow(gaussian,rgba(58,46,116,0.10),10,0,0,3);
                                              -fx-padding:16;">
                        <Label text="Ambiance de la communaute" style="-fx-font-size:13; -fx-font-weight:800; -fx-text-fill:#1f1a42;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="-" style="-fx-font-size:13;"/>
                            <Label text="Reponses rapides et utiles" style="-fx-font-size:12; -fx-text-fill:#5d587f;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="-" style="-fx-font-size:13;"/>
                            <Label text="Discussions structurees" style="-fx-font-size:12; -fx-text-fill:#5d587f;"/>
                        </HBox>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label text="-" style="-fx-font-size:13;"/>
                            <Label text="Partage de ressources utiles" style="-fx-font-size:12; -fx-text-fill:#5d587f;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </HBox>
        </VBox>
        </ScrollPane>
    </center>
</BorderPane>
