<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.FrontCommunauteDetailController"
            style="-fx-background-color:#f0eeff;">

    <center>
        <VBox spacing="0">

            <!-- ══════════ HERO ══════════ -->
            <StackPane minHeight="190" maxHeight="190">

                <!-- Gradient bg -->
                <VBox style="-fx-background-color:linear-gradient(to bottom right,#6d28d9,#7c3aed,#4f46e5,#818cf8);
                             -fx-min-height:190; -fx-max-height:190;"/>
                <VBox style="-fx-background-color:rgba(255,255,255,0.04);
                             -fx-min-height:190; -fx-max-height:190;"/>

                <!-- Decorative circles -->
                <Circle radius="160" fill="rgba(255,255,255,0.04)" translateX="-340" translateY="-40"/>
                <Circle radius="100" fill="rgba(255,255,255,0.05)" translateX="300"  translateY="30"/>

                <VBox spacing="0">
                    <!-- Top bar -->
                    <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-padding:16 64 0 64;">
                        <Button text="← Retour" onAction="#onRetour"
                                style="-fx-background-color:rgba(255,255,255,0.18);
                                       -fx-text-fill:white; -fx-font-size:11; -fx-font-weight:700;
                                       -fx-padding:7 18 7 18; -fx-background-radius:30;
                                       -fx-cursor:hand; -fx-border-width:1;
                                       -fx-border-color:rgba(255,255,255,0.3); -fx-border-radius:30;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="↺  Rafraîchir" onAction="#onRefresh"
                                style="-fx-background-color:rgba(255,255,255,0.12);
                                       -fx-text-fill:rgba(255,255,255,0.85); -fx-font-size:10; -fx-font-weight:600;
                                       -fx-padding:7 14 7 14; -fx-background-radius:30;
                                       -fx-cursor:hand; -fx-border-width:1;
                                       -fx-border-color:rgba(255,255,255,0.2); -fx-border-radius:30;"/>
                    </HBox>

                    <!-- Identity -->
                    <HBox spacing="18" alignment="CENTER_LEFT"
                          style="-fx-padding:14 64 20 64;" VBox.vgrow="ALWAYS">

                        <!-- Avatar -->
                        <Label fx:id="labelAvatar"
                               style="-fx-background-color:white;
                                      -fx-text-fill:#7c3aed; -fx-font-size:22; -fx-font-weight:900;
                                      -fx-background-radius:50%; -fx-alignment:center;
                                      -fx-min-width:64; -fx-min-height:64;
                                      -fx-max-width:64; -fx-max-height:64;
                                      -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.35),14,0,0,4);
                                      -fx-border-color:rgba(255,255,255,0.9);
                                      -fx-border-radius:50%; -fx-border-width:2.5;"/>

                        <VBox spacing="6" alignment="CENTER_LEFT">
                            <Label fx:id="labelNom" text=""
                                   style="-fx-font-size:22; -fx-font-weight:900; -fx-text-fill:white;
                                          -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),6,0,0,2);"/>
                            <Label fx:id="labelDescription" text="" wrapText="true"
                                   style="-fx-font-size:12; -fx-text-fill:rgba(255,255,255,0.68); -fx-max-width:480;"/>
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label fx:id="labelMembresCount"
                                       style="-fx-background-color:rgba(255,255,255,0.18);
                                              -fx-text-fill:white; -fx-font-size:10; -fx-font-weight:700;
                                              -fx-padding:4 14 4 14; -fx-background-radius:30;
                                              -fx-border-color:rgba(255,255,255,0.3); -fx-border-radius:30; -fx-border-width:1;"/>
                                <Label text="✅  Vérifiée"
                                       style="-fx-background-color:rgba(52,211,153,0.22);
                                              -fx-text-fill:#a7f3d0; -fx-font-size:10; -fx-font-weight:700;
                                              -fx-padding:4 14 4 14; -fx-background-radius:30;
                                              -fx-border-color:rgba(52,211,153,0.35); -fx-border-radius:30; -fx-border-width:1;"/>
                                <Button fx:id="btnGererMembres" text="⚙  Gérer les membres"
                                        onAction="#onGererMembres" visible="false" managed="false"
                                        style="-fx-background-color:white; -fx-text-fill:#7c3aed;
                                               -fx-font-size:10; -fx-font-weight:800;
                                               -fx-padding:4 16 4 16; -fx-background-radius:30;
                                               -fx-cursor:hand; -fx-border-width:0;
                                               -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.15),6,0,0,2);"/>
                            </HBox>
                        </VBox>
                    </HBox>
                </VBox>
            </StackPane>

            <!-- ══════════ STATS BAR ══════════ -->
            <HBox alignment="CENTER" spacing="0"
                  style="-fx-background-color:white;
                         -fx-border-color:#ede9fe; -fx-border-width:0 0 1 0;
                         -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.07),12,0,0,4);">
                <VBox alignment="CENTER" spacing="4" prefWidth="200" prefHeight="76"
                      style="-fx-border-color:transparent #ede9fe transparent transparent; -fx-border-width:0 1 0 0;">
                    <Label fx:id="statPosts" text="—"
                           style="-fx-font-size:26; -fx-font-weight:900; -fx-text-fill:#7c3aed;"/>
                    <Label text="PUBLICATIONS"
                           style="-fx-font-size:9; -fx-text-fill:#c4b5fd; -fx-font-weight:800; -fx-letter-spacing:1;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" prefWidth="200" prefHeight="76"
                      style="-fx-border-color:transparent #ede9fe transparent transparent; -fx-border-width:0 1 0 0;">
                    <Label fx:id="statMembres" text="—"
                           style="-fx-font-size:26; -fx-font-weight:900; -fx-text-fill:#7c3aed;"/>
                    <Label text="MEMBRES"
                           style="-fx-font-size:9; -fx-text-fill:#c4b5fd; -fx-font-weight:800; -fx-letter-spacing:1;"/>
                </VBox>
                <VBox alignment="CENTER" spacing="4" prefWidth="200" prefHeight="76">
                    <Label text="🔥  Actif"
                           style="-fx-font-size:20; -fx-font-weight:800; -fx-text-fill:#f59e0b;"/>
                    <Label text="STATUT"
                           style="-fx-font-size:9; -fx-text-fill:#c4b5fd; -fx-font-weight:800; -fx-letter-spacing:1;"/>
                </VBox>
            </HBox>

            <!-- ══════════ MAIN CONTENT ══════════ -->
            <ScrollPane fx:id="mainScrollPane" fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                        style="-fx-background-color:#f0eeff; -fx-background:#f0eeff; -fx-border-width:0;">
                <HBox spacing="26" style="-fx-padding:34 72 60 72; -fx-background-color:#f0eeff;">

                    <!-- ── FEED ── -->
                    <VBox spacing="22" HBox.hgrow="ALWAYS">

                        <!-- CREATE POST card -->
                        <VBox spacing="0"
                              style="-fx-background-color:white;
                                     -fx-background-radius:24;
                                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.12),24,0,0,8);
                                     -fx-padding:28;">

                            <HBox spacing="16" alignment="CENTER_LEFT" style="-fx-padding:0 0 20 0;">
                                <Label fx:id="labelAvatarPost"
                                       style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                              -fx-text-fill:white; -fx-font-size:16; -fx-font-weight:800;
                                              -fx-background-radius:50%; -fx-alignment:center;
                                              -fx-min-width:50; -fx-min-height:50; -fx-max-width:50; -fx-max-height:50;
                                              -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.45),12,0,0,0);"/>
                                <VBox spacing="2">
                                    <Label text="Créer une publication"
                                           style="-fx-font-size:16; -fx-font-weight:900; -fx-text-fill:#1e1b4b;"/>
                                    <Label text="Partagez avec votre communauté"
                                           style="-fx-font-size:11; -fx-text-fill:#c4b5fd;"/>
                                </VBox>
                            </HBox>

                            <Separator style="-fx-background-color:#f3f0ff; -fx-opacity:1;"/>

                            <VBox spacing="14" style="-fx-padding:20 0 0 0;">
                                <TextField fx:id="fieldTitre"
                                           promptText="✨  Titre accrocheur (optionnel)"
                                           style="-fx-background-color:#faf8ff;
                                                  -fx-background-radius:14; -fx-border-width:1.5;
                                                  -fx-border-color:#e9e4ff; -fx-border-radius:14;
                                                  -fx-padding:14 20 14 20; -fx-font-size:13;
                                                  -fx-text-fill:#1e1b4b;"/>
                                <TextArea fx:id="fieldContenu"
                                          promptText="💬  Quoi de neuf ? Partagez vos idées, questions, ressources..."
                                          prefRowCount="4"
                                          style="-fx-background-color:#faf8ff;
                                                 -fx-background-radius:14; -fx-border-width:1.5;
                                                 -fx-border-color:#e9e4ff; -fx-border-radius:14;
                                                 -fx-padding:14 20 14 20; -fx-font-size:13;
                                                 -fx-text-fill:#1e1b4b;"/>
                                <TextField fx:id="fieldTags"
                                           promptText="🏷  Tags (optionnel) — ex: java, spring, backend"
                                           style="-fx-background-color:#faf8ff;
                                                  -fx-background-radius:14; -fx-border-width:1.5;
                                                  -fx-border-color:#e9e4ff; -fx-border-radius:14;
                                                  -fx-padding:14 20 14 20; -fx-font-size:12;
                                                  -fx-text-fill:#1e1b4b;"/>

                                <!-- Media preview -->
                                <HBox fx:id="mediaPreviewBox" spacing="10" alignment="CENTER_LEFT"
                                      visible="false" managed="false"/>

                                <HBox alignment="CENTER_LEFT" spacing="10">
                                    <!-- Attach buttons -->
                                    <Button fx:id="btnAttachImage" text="🖼  Image"
                                            onAction="#onAttachImage"
                                            style="-fx-background-color:#f5f3ff; -fx-text-fill:#7c3aed;
                                                   -fx-font-size:11; -fx-font-weight:700;
                                                   -fx-padding:8 16; -fx-background-radius:20;
                                                   -fx-cursor:hand; -fx-border-width:0;"/>
                                    <Button fx:id="btnAttachVideo" text="🎬  Vidéo"
                                            onAction="#onAttachVideo"
                                            style="-fx-background-color:#f5f3ff; -fx-text-fill:#7c3aed;
                                                   -fx-font-size:11; -fx-font-weight:700;
                                                   -fx-padding:8 16; -fx-background-radius:20;
                                                   -fx-cursor:hand; -fx-border-width:0;"/>
                                    <Button fx:id="btnAttachFile" text="📎  Fichier"
                                            onAction="#onAttachFile"
                                            style="-fx-background-color:#f5f3ff; -fx-text-fill:#7c3aed;
                                                   -fx-font-size:11; -fx-font-weight:700;
                                                   -fx-padding:8 16; -fx-background-radius:20;
                                                   -fx-cursor:hand; -fx-border-width:0;"/>
                                    <Region HBox.hgrow="ALWAYS"/>
                                    <Button text="🚀  Publier" onAction="#onPublier"
                                            style="-fx-background-color:linear-gradient(to right,#7c3aed,#4f46e5);
                                                   -fx-text-fill:white; -fx-font-weight:900; -fx-font-size:13;
                                                   -fx-padding:13 40 13 40; -fx-background-radius:30;
                                                   -fx-cursor:hand; -fx-border-width:0;
                                                   -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.5),18,0,0,6);"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Posts injected here -->
                        <VBox fx:id="postsPane" spacing="22"/>

                    </VBox>

                    <!-- ── SIDEBAR ── -->
                    <VBox spacing="18" prefWidth="285" minWidth="265" maxWidth="305">

                        <!-- About -->
                        <VBox spacing="16"
                              style="-fx-background-color:white; -fx-background-radius:24;
                                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.08),16,0,0,5);
                                     -fx-padding:24;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="ℹ"
                                       style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                              -fx-text-fill:white; -fx-font-size:13;
                                              -fx-background-radius:12; -fx-padding:8 11 8 11;"/>
                                <Label text="À propos"
                                       style="-fx-font-size:15; -fx-font-weight:900; -fx-text-fill:#1e1b4b;"/>
                            </HBox>
                            <Separator style="-fx-background-color:#f3f0ff;"/>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <Label text="👥"
                                       style="-fx-background-color:#f5f3ff; -fx-background-radius:10;
                                              -fx-padding:8 10 8 10; -fx-font-size:14;"/>
                                <Label fx:id="labelSidebarMembres"
                                       style="-fx-font-size:13; -fx-text-fill:#4b5563; -fx-font-weight:600;"/>
                            </HBox>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <Label text="📅"
                                       style="-fx-background-color:#f5f3ff; -fx-background-radius:10;
                                              -fx-padding:8 10 8 10; -fx-font-size:14;"/>
                                <Label text="Communauté active"
                                       style="-fx-font-size:13; -fx-text-fill:#4b5563; -fx-font-weight:600;"/>
                            </HBox>
                            <HBox spacing="14" alignment="CENTER_LEFT">
                                <Label text="🌐"
                                       style="-fx-background-color:#f5f3ff; -fx-background-radius:10;
                                              -fx-padding:8 10 8 10; -fx-font-size:14;"/>
                                <Label text="Ouverte à tous"
                                       style="-fx-font-size:13; -fx-text-fill:#4b5563; -fx-font-weight:600;"/>
                            </HBox>
                        </VBox>

                        <!-- Rules -->
                        <VBox spacing="16"
                              style="-fx-background-color:white; -fx-background-radius:24;
                                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.08),16,0,0,5);
                                     -fx-padding:24;">
                            <HBox spacing="12" alignment="CENTER_LEFT">
                                <Label text="📋"
                                       style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                              -fx-text-fill:white; -fx-font-size:13;
                                              -fx-background-radius:12; -fx-padding:8 11 8 11;"/>
                                <Label text="Règles"
                                       style="-fx-font-size:15; -fx-font-weight:900; -fx-text-fill:#1e1b4b;"/>
                            </HBox>
                            <Separator style="-fx-background-color:#f3f0ff;"/>
                            <VBox spacing="14">
                                <HBox spacing="14" alignment="TOP_LEFT">
                                    <Label text="1"
                                           style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                                  -fx-text-fill:white; -fx-font-size:10; -fx-font-weight:900;
                                                  -fx-background-radius:50%; -fx-min-width:26; -fx-min-height:26;
                                                  -fx-max-width:26; -fx-max-height:26; -fx-alignment:center;"/>
                                    <Label text="Respectez tous les membres" wrapText="true"
                                           style="-fx-font-size:12; -fx-text-fill:#374151; -fx-font-weight:600;"/>
                                </HBox>
                                <HBox spacing="14" alignment="TOP_LEFT">
                                    <Label text="2"
                                           style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                                  -fx-text-fill:white; -fx-font-size:10; -fx-font-weight:900;
                                                  -fx-background-radius:50%; -fx-min-width:26; -fx-min-height:26;
                                                  -fx-max-width:26; -fx-max-height:26; -fx-alignment:center;"/>
                                    <Label text="Partagez du contenu de qualité" wrapText="true"
                                           style="-fx-font-size:12; -fx-text-fill:#374151; -fx-font-weight:600;"/>
                                </HBox>
                                <HBox spacing="14" alignment="TOP_LEFT">
                                    <Label text="3"
                                           style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                                  -fx-text-fill:white; -fx-font-size:10; -fx-font-weight:900;
                                                  -fx-background-radius:50%; -fx-min-width:26; -fx-min-height:26;
                                                  -fx-max-width:26; -fx-max-height:26; -fx-alignment:center;"/>
                                    <Label text="Pas de spam ni de publicité" wrapText="true"
                                           style="-fx-font-size:12; -fx-text-fill:#374151; -fx-font-weight:600;"/>
                                </HBox>
                                <HBox spacing="14" alignment="TOP_LEFT">
                                    <Label text="4"
                                           style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                                  -fx-text-fill:white; -fx-font-size:10; -fx-font-weight:900;
                                                  -fx-background-radius:50%; -fx-min-width:26; -fx-min-height:26;
                                                  -fx-max-width:26; -fx-max-height:26; -fx-alignment:center;"/>
                                    <Label text="Encouragez et entraidez-vous" wrapText="true"
                                           style="-fx-font-size:12; -fx-text-fill:#374151; -fx-font-weight:600;"/>
                                </HBox>
                            </VBox>
                        </VBox>

                        <!-- Tip card -->
                        <VBox spacing="12"
                              style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                     -fx-background-radius:24; -fx-padding:24;
                                     -fx-border-width:0;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.45),22,0,0,8);">
                            <HBox spacing="8" alignment="CENTER_LEFT">
                                <Label text="💡"
                                       style="-fx-background-color:rgba(255,255,255,0.2);
                                              -fx-background-radius:10; -fx-padding:6 8 6 8; -fx-font-size:14;"/>
                                <Label text="Conseil du jour"
                                       style="-fx-font-size:13; -fx-font-weight:900; -fx-text-fill:white;"/>
                            </HBox>
                            <Label text="Posez des questions précises pour obtenir de meilleures réponses de la communauté !"
                                   wrapText="true"
                                   style="-fx-font-size:12; -fx-text-fill:rgba(255,255,255,0.8); -fx-line-spacing:5;"/>
                        </VBox>

                        <!-- Posts similaires -->
                        <VBox fx:id="similarPostsBox" spacing="14"
                              style="-fx-background-color:white; -fx-background-radius:24;
                                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.08),16,0,0,5);
                                     -fx-padding:22;" visible="false" managed="false">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="✨"
                                       style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                              -fx-text-fill:white; -fx-font-size:12;
                                              -fx-background-radius:10; -fx-padding:7 10 7 10;"/>
                                <Label text="Posts similaires"
                                       style="-fx-font-size:15; -fx-font-weight:900; -fx-text-fill:#1e1b4b;"/>
                            </HBox>
                            <Separator style="-fx-background-color:#f3f0ff;"/>
                            <VBox fx:id="similarPostsList" spacing="10"/>
                        </VBox>

                        <!-- Ressources recommandées -->
                        <VBox fx:id="resourcesBox" spacing="14"
                              style="-fx-background-color:white; -fx-background-radius:24;
                                     -fx-border-color:#ede9fe; -fx-border-radius:24; -fx-border-width:1.5;
                                     -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.08),16,0,0,5);
                                     -fx-padding:22;" visible="false" managed="false">
                            <HBox spacing="10" alignment="CENTER_LEFT">
                                <Label text="🎯"
                                       style="-fx-background-color:linear-gradient(to bottom right,#7c3aed,#4f46e5);
                                              -fx-text-fill:white; -fx-font-size:12;
                                              -fx-background-radius:10; -fx-padding:7 10 7 10;"/>
                                <Label text="Ressources recommandées"
                                       style="-fx-font-size:14; -fx-font-weight:900; -fx-text-fill:#1e1b4b;"/>
                            </HBox>
                            <Separator style="-fx-background-color:#f3f0ff;"/>
                            <VBox fx:id="resourcesList" spacing="10"/>
                        </VBox>

                    </VBox>

                </HBox>
            </ScrollPane>

        </VBox>
    </center>
</BorderPane>
