<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ResultChallengeController"
            maxWidth="Infinity" maxHeight="Infinity"
            style="-fx-background-color:#f8f9fa;">

    <top>
        <fx:include source="../components/navbar_front.fxml" fx:id="navbar"/>
    </top>

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:#f8f9fa; -fx-background:transparent; -fx-border-width:0;">
            <VBox alignment="TOP_CENTER" spacing="0"
                  style="-fx-background-color:#f8f9fa;">

                <!-- Hero banner -->
                <VBox alignment="CENTER" spacing="8" prefHeight="160"
                      style="-fx-background-color:linear-gradient(to bottom right,#7a6ad8,#4e3b9c);
                             -fx-padding:40 80 40 80;">
                    <Label text="RÉSULTAT"
                           style="-fx-font-size:12; -fx-font-weight:600; -fx-text-fill:rgba(255,255,255,0.8);
                                  -fx-letter-spacing:1;"/>
                    <Label fx:id="challengeTitle" text=""
                           style="-fx-font-size:34; -fx-font-weight:800; -fx-text-fill:white;"/>
                </VBox>

                <!-- Main content -->
                <VBox alignment="TOP_CENTER" spacing="24"
                      style="-fx-padding:40 0 60 0; -fx-background-color:#f8f9fa;">
                    <VBox spacing="24" prefWidth="750" maxWidth="750">

                        <!-- Carte de résultat -->
                        <VBox spacing="20"
                              style="-fx-background-color:white; -fx-background-radius:23;
                                     -fx-border-color:#eeeeee; -fx-border-radius:23;
                                     -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.08),44,0,0,0);
                                     -fx-padding:40 32 40 32;">

                            <!-- Score -->
                            <VBox spacing="12" alignment="CENTER">
                                <Label fx:id="scoreLabel" text="0/100"
                                       style="-fx-font-size:48; -fx-font-weight:800; -fx-text-fill:#7a6ad8;"/>
                                <Label fx:id="percentageLabel" text="0%"
                                       style="-fx-font-size:20; -fx-font-weight:600; -fx-text-fill:#777;"/>
                            </VBox>

                            <Separator style="-fx-background-color:#eeeeee;"/>

                            <!-- Niveau -->
                            <HBox spacing="10">
                                <Label text="⭐ Niveau" style="-fx-font-size:13; -fx-font-weight:600; -fx-text-fill:#777;" prefWidth="120"/>
                                <Label fx:id="niveauLabel" text="" style="-fx-font-size:14; -fx-text-fill:#1e1e1e;"/>
                            </HBox>

                            <Separator style="-fx-background-color:#eeeeee;"/>

                            <!-- Section rating 5 étoiles -->
                            <VBox spacing="10" alignment="CENTER">
                                <Label text="Évaluez ce challenge"
                                       style="-fx-font-size:14; -fx-font-weight:700; -fx-text-fill:#1e1e1e;"/>
                                <HBox fx:id="starsContainer" spacing="8" alignment="CENTER"/>
                                <Label fx:id="ratingMessage" text=""
                                       style="-fx-font-size:12; -fx-text-fill:#28a745;"/>
                            </VBox>

                            <Separator style="-fx-background-color:#eeeeee;"/>

                            <!-- Citation de félicitations -->
                            <Label fx:id="congratsQuoteLabel" text=""
                                   style="-fx-font-size:14; -fx-font-style:italic; -fx-text-fill:#7a6ad8;
                                          -fx-background-color:rgba(122,106,216,0.08); -fx-background-radius:15;
                                          -fx-padding:12 20 12 20; -fx-wrap-text:true; -fx-alignment:CENTER;"
                                   wrapText="true" alignment="CENTER" visible="false" managed="false"/>

                            <!-- Section GIF de réaction -->
                            <VBox spacing="10" alignment="CENTER" style="-fx-padding:10 0 10 0;">
                                <Label text="🎬 Votre réaction du jour :"
                                       style="-fx-font-size:13; -fx-font-weight:700; -fx-text-fill:#7a6ad8;"/>
                                <ImageView fx:id="reactionGif" fitWidth="250" fitHeight="180" preserveRatio="true"
                                           style="-fx-effect:dropshadow(gaussian,rgba(0,0,0,0.15),8,0,0,2);"
                                           visible="false" managed="false"/>
                            </VBox>

                            <Separator style="-fx-background-color:#eeeeee;"/>

                            <!-- Section Analyse IA -->
                            <VBox spacing="15">
                                <Label text="🤖 CORRECTION DÉTAILLÉE PAR L'IA"
                                       style="-fx-font-size:16; -fx-font-weight:700; -fx-text-fill:#7a6ad8;"/>
                                <TextArea fx:id="aiAnalysisArea" editable="false" wrapText="true"
                                          style="-fx-background-color:#f8f9fa; -fx-border-color:#e0e0e0;
                                                 -fx-border-radius:10; -fx-background-radius:10;
                                                 -fx-font-size:13; -fx-font-family:'Courier New', monospace;
                                                 -fx-font-weight:normal;"
                                          prefHeight="400" visible="false" managed="false"/>
                            </VBox>

                            <Button text="🏠 Retour aux challenges" onAction="#onBackToChallenges"
                                    style="-fx-background-color:linear-gradient(to right,#7a6ad8,#4e3b9c);
                                           -fx-text-fill:white; -fx-font-size:14; -fx-font-weight:700;
                                           -fx-padding:14 36 14 36; -fx-background-radius:30;
                                           -fx-cursor:hand; -fx-border-width:0;
                                           -fx-effect:dropshadow(gaussian,rgba(122,106,216,0.4),12,0,0,4);"/>
                        </VBox>

                    </VBox>
                </VBox>
            </VBox>
        </ScrollPane>
    </center>
</BorderPane>