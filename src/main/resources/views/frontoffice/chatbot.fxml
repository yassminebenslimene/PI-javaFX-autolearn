<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ChatbotPageController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color:#faf8ff;">

    <!-- Main Chat Container -->
    <center>
        <HBox spacing="0" style="-fx-background-color:#faf8ff;">
            
            <!-- Left Side: Large Avatar + Customization -->
            <VBox spacing="20" alignment="TOP_CENTER"
                  style="-fx-background-color:linear-gradient(to bottom,#7c3aed,#6d28d9);
                         -fx-padding:40 32 40 32; -fx-min-width:380; -fx-max-width:380;">
                
                <!-- Title -->
                <VBox spacing="6" alignment="CENTER">
                    <Label text="🤖 Assistant AutoLearn"
                           style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <Label text="Votre compagnon d'apprentissage personnalisé"
                           style="-fx-font-size:12; -fx-text-fill:rgba(255,255,255,0.75); -fx-wrap-text:true; -fx-text-alignment:center;"/>
                </VBox>
                
                <!-- Large Avatar Display -->
                <VBox spacing="12" alignment="CENTER"
                      style="-fx-background-color:rgba(255,255,255,0.15); -fx-background-radius:20; -fx-padding:24;">
                    <StackPane fx:id="largeAvatarContainer" 
                               minWidth="180" minHeight="180" 
                               maxWidth="180" maxHeight="180"
                               style="-fx-background-color:white; -fx-background-radius:90;"/>
                    
                    <HBox spacing="4" alignment="CENTER">
                        <Circle radius="4" style="-fx-fill:#86efac;"/>
                        <Label fx:id="labelAvatarStatus" text="En ligne"
                               style="-fx-font-size:11; -fx-text-fill:rgba(255,255,255,0.85); -fx-font-weight:600;"/>
                    </HBox>
                </VBox>
                
                <!-- Customize Button -->
                <Button text="✨ Personnaliser mon assistant" onAction="#onCustomize"
                        maxWidth="Infinity"
                        style="-fx-background-color:rgba(255,255,255,0.25); -fx-text-fill:white;
                               -fx-font-size:13; -fx-font-weight:700; -fx-padding:12 20;
                               -fx-background-radius:12; -fx-cursor:hand; -fx-border-width:1;
                               -fx-border-color:rgba(255,255,255,0.3); -fx-border-radius:12;"/>
                
                <!-- Info Cards -->
                <VBox spacing="12" VBox.vgrow="ALWAYS">
                    <VBox spacing="8" style="-fx-background-color:rgba(255,255,255,0.12); -fx-background-radius:12; -fx-padding:16;">
                        <Label text="💡 Astuce"
                               style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(255,255,255,0.9);"/>
                        <Label text="Posez-moi des questions sur vos cours, challenges, ou demandez-moi de vous guider !"
                               wrapText="true"
                               style="-fx-font-size:11; -fx-text-fill:rgba(255,255,255,0.75); -fx-line-spacing:2;"/>
                    </VBox>
                    
                    <VBox spacing="8" style="-fx-background-color:rgba(255,255,255,0.12); -fx-background-radius:12; -fx-padding:16;">
                        <Label text="🎯 Exemples"
                               style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(255,255,255,0.9);"/>
                        <Label text="• Montre-moi mes cours\n• Quels sont les prochains événements ?\n• Aide-moi avec ce chapitre"
                               wrapText="true"
                               style="-fx-font-size:10; -fx-text-fill:rgba(255,255,255,0.7); -fx-line-spacing:3;"/>
                    </VBox>
                </VBox>
            </VBox>
            
            <!-- Right Side: Chat Interface -->
            <VBox spacing="0" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:white;">
                
                <!-- Chat Header -->
                <HBox alignment="CENTER_LEFT" spacing="12"
                      style="-fx-background-color:#f5f3ff; -fx-padding:20 28;
                             -fx-border-color:transparent transparent #ede9fe transparent; -fx-border-width:0 0 1 0;">
                    
                    <!-- Small Avatar -->
                    <StackPane fx:id="smallAvatarContainer" 
                               minWidth="48" minHeight="48" 
                               maxWidth="48" maxHeight="48"/>
                    
                    <VBox spacing="2" HBox.hgrow="ALWAYS">
                        <Label text="Conversation"
                               style="-fx-font-size:16; -fx-font-weight:800; -fx-text-fill:#1e1b4b;"/>
                        <Label fx:id="labelChatStatus" text="Prêt à vous aider"
                               style="-fx-font-size:11; -fx-text-fill:#7c3aed;"/>
                    </VBox>
                    
                    <Button text="🗑 Effacer" onAction="#onClear"
                            style="-fx-background-color:#f5f3ff; -fx-text-fill:#7c3aed;
                                   -fx-font-size:12; -fx-font-weight:600; -fx-padding:8 16;
                                   -fx-background-radius:20; -fx-cursor:hand;
                                   -fx-border-color:#ddd6fe; -fx-border-width:1; -fx-border-radius:20;"/>
                </HBox>
                
                <!-- Messages Area -->
                <ScrollPane fx:id="scrollPane" fitToWidth="true" VBox.vgrow="ALWAYS"
                            hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                            style="-fx-background-color:white; -fx-background:white; -fx-border-width:0;">
                    <VBox fx:id="messagesBox" spacing="12"
                          style="-fx-padding:24 28 24 28; -fx-background-color:white;"/>
                </ScrollPane>
                
                <!-- Input Area -->
                <HBox alignment="CENTER" spacing="12"
                      style="-fx-background-color:#f5f3ff; -fx-padding:20 28;
                             -fx-border-color:#ede9fe transparent transparent transparent; -fx-border-width:1 0 0 0;">
                    
                    <TextField fx:id="inputField"
                               promptText="Écrivez votre message..."
                               HBox.hgrow="ALWAYS"
                               style="-fx-background-color:white;
                                      -fx-background-radius:24;
                                      -fx-border-color:#ddd6fe; -fx-border-radius:24; -fx-border-width:1.5;
                                      -fx-padding:12 20; -fx-font-size:13;
                                      -fx-text-fill:#1e1b4b; -fx-prompt-text-fill:#a78bfa;"/>
                    
                    <Button fx:id="btnSend" text="Envoyer ▶" onAction="#onSend"
                            style="-fx-background-color:linear-gradient(to right,#7c3aed,#4f46e5);
                                   -fx-text-fill:white; -fx-font-size:13; -fx-font-weight:700;
                                   -fx-padding:12 24;
                                   -fx-background-radius:24; -fx-cursor:hand; -fx-border-width:0;
                                   -fx-effect:dropshadow(gaussian,rgba(109,40,217,0.4),8,0,0,2);"/>
                </HBox>
            </VBox>
        </HBox>
    </center>

</BorderPane>
