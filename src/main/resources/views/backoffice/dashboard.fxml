<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="ALWAYS" style="-fx-background:#0a0f0d; -fx-background-color:#0a0f0d;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.DashboardController">
    <VBox spacing="0" style="-fx-background-color:#0a0f0d;">
        <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

        <!-- ══ ANIMATED STATS ROW WITH 3D EFFECT ══ -->
        <HBox alignment="CENTER_LEFT" spacing="14">

            <!-- Total Users -->
            <VBox fx:id="cardTotal" prefHeight="110" prefWidth="200" spacing="4"
                  style="-fx-background-color:linear-gradient(to bottom right, rgba(52,211,153,0.12), rgba(16,185,129,0.08));
                         -fx-background-radius:18; -fx-border-color:rgba(52,211,153,0.35); -fx-border-radius:18;
                         -fx-padding:16 18 16 18; -fx-effect:dropshadow(gaussian,rgba(52,211,153,0.25),18,0.3,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size:11; -fx-text-fill:rgba(52,211,153,0.8); -fx-font-weight:700; -fx-letter-spacing:1.5;" text="TOTAL USERS" />
                        <Label fx:id="labelTotalUsers" style="-fx-font-size:36; -fx-font-weight:900; -fx-text-fill:#34d399; -fx-effect:dropshadow(gaussian,rgba(52,211,153,0.6),8,0,0,2);" text="0" />
                    </VBox>
                    <Label style="-fx-font-size:32; -fx-background-color:rgba(52,211,153,0.2);
                                  -fx-background-radius:14; -fx-padding:10 12 10 12;" text="👥" />
                </HBox>
                <Label fx:id="labelActiveWeek" style="-fx-font-size:10; -fx-text-fill:rgba(52,211,153,0.7); -fx-font-weight:600;" text="— actifs cette semaine" />
                <Label fx:id="labelGrowthRate" style="-fx-font-size:9; -fx-text-fill:rgba(52,211,153,0.5);" text="📈 +0% vs semaine dernière" />
            </VBox>

            <!-- Etudiants -->
            <VBox fx:id="cardEtudiants" prefHeight="110" prefWidth="200" spacing="4"
                  style="-fx-background-color:linear-gradient(to bottom right, rgba(251,191,36,0.12), rgba(245,158,11,0.08));
                         -fx-background-radius:18; -fx-border-color:rgba(251,191,36,0.35); -fx-border-radius:18;
                         -fx-padding:16 18 16 18; -fx-effect:dropshadow(gaussian,rgba(251,191,36,0.25),18,0.3,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size:11; -fx-text-fill:rgba(251,191,36,0.8); -fx-font-weight:700; -fx-letter-spacing:1.5;" text="ÉTUDIANTS" />
                        <Label fx:id="labelTotalEtudiants" style="-fx-font-size:36; -fx-font-weight:900; -fx-text-fill:#fbbf24; -fx-effect:dropshadow(gaussian,rgba(251,191,36,0.6),8,0,0,2);" text="0" />
                    </VBox>
                    <Label style="-fx-font-size:32; -fx-background-color:rgba(251,191,36,0.2);
                                  -fx-background-radius:14; -fx-padding:10 12 10 12;" text="🎓" />
                </HBox>
                <Label fx:id="labelNewWeek" style="-fx-font-size:10; -fx-text-fill:rgba(251,191,36,0.7); -fx-font-weight:600;" text="— nouveaux cette semaine" />
                <Label fx:id="labelRetentionRate" style="-fx-font-size:9; -fx-text-fill:rgba(251,191,36,0.5);" text="🎯 Taux de rétention: 0%" />
            </VBox>

            <!-- Admins -->
            <VBox fx:id="cardAdmins" prefHeight="110" prefWidth="200" spacing="4"
                  style="-fx-background-color:linear-gradient(to bottom right, rgba(248,113,113,0.12), rgba(239,68,68,0.08));
                         -fx-background-radius:18; -fx-border-color:rgba(248,113,113,0.35); -fx-border-radius:18;
                         -fx-padding:16 18 16 18; -fx-effect:dropshadow(gaussian,rgba(248,113,113,0.25),18,0.3,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="0">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label style="-fx-font-size:11; -fx-text-fill:rgba(248,113,113,0.8); -fx-font-weight:700; -fx-letter-spacing:1.5;" text="ADMINS" />
                        <Label fx:id="labelTotalAdmins" style="-fx-font-size:36; -fx-font-weight:900; -fx-text-fill:#f87171; -fx-effect:dropshadow(gaussian,rgba(248,113,113,0.6),8,0,0,2);" text="0" />
                    </VBox>
                    <Label style="-fx-font-size:32; -fx-background-color:rgba(248,113,113,0.2);
                                  -fx-background-radius:14; -fx-padding:10 12 10 12;" text="🛡" />
                </HBox>
                <Label fx:id="labelSuspended" style="-fx-font-size:10; -fx-text-fill:rgba(248,113,113,0.7); -fx-font-weight:600;" text="— suspendus" />
                <Label fx:id="labelAvgResponseTime" style="-fx-font-size:9; -fx-text-fill:rgba(248,113,113,0.5);" text="⚡ Temps réponse moyen: 0h" />
            </VBox>

            <Region HBox.hgrow="ALWAYS" />
        </HBox>

        <Region prefHeight="18" />

        <!-- ══ HEATMAP + AI RISK ROW ══ -->
        <HBox spacing="14">

            <!-- Activity Heatmap Card with 3D bars - FULL SIZE -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:linear-gradient(to bottom, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
                         -fx-background-radius:20; -fx-border-color:rgba(255,255,255,0.12); -fx-border-radius:20;
                         -fx-padding:18 20 18 20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.4),16,0.2,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Label style="-fx-font-size:16; -fx-font-weight:800; -fx-text-fill:white; -fx-effect:dropshadow(gaussian,rgba(255,255,255,0.4),6,0,0,2);" text="📊 Activité par heure — Vue 3D" />
                    <Label style="-fx-font-size:11; -fx-text-fill:rgba(245,245,244,0.5); -fx-background-color:rgba(255,255,255,0.1);
                                  -fx-background-radius:8; -fx-padding:3 10 3 10; -fx-font-weight:600;" text="Connexions / 24h" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="labelPeakHour" style="-fx-font-size:11; -fx-text-fill:rgba(52,211,153,0.9); -fx-font-weight:700; -fx-background-color:rgba(52,211,153,0.15); -fx-background-radius:8; -fx-padding:4 12 4 12;" text="🔥 Pic: --h" />
                </HBox>
                <!-- 3D Canvas - EXPANDED -->
                <StackPane style="-fx-background-color:rgba(0,0,0,0.2); -fx-background-radius:12; -fx-padding:10;">
                    <Canvas fx:id="heatmapCanvas" height="320" width="900" />
                </StackPane>
                <!-- Hour labels - aligned with canvas -->
                <HBox fx:id="heatmapLabels" spacing="0" alignment="CENTER" style="-fx-padding:4 40 0 40; -fx-pref-width:900;" />
            </VBox>

            <!-- AI Risk Summary Card with advanced features -->
            <VBox prefWidth="280" spacing="12"
                  style="-fx-background-color:linear-gradient(to bottom, rgba(139,92,246,0.08), rgba(109,40,217,0.04));
                         -fx-background-radius:20; -fx-border-color:rgba(139,92,246,0.25); -fx-border-radius:20;
                         -fx-padding:18 20 18 20; -fx-effect:dropshadow(gaussian,rgba(139,92,246,0.3),16,0.2,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:15; -fx-font-weight:700; -fx-text-fill:white; -fx-effect:dropshadow(gaussian,rgba(255,255,255,0.3),4,0,0,1);" text="🤖 IA — Risque abandon" />
                    <Region HBox.hgrow="ALWAYS" />
                    <StackPane fx:id="aiLoadingIndicator" prefHeight="16" prefWidth="16">
                        <Label style="-fx-font-size:12; -fx-text-fill:rgba(139,92,246,0.8);" text="⟳" />
                    </StackPane>
                </HBox>
                <Label style="-fx-font-size:10; -fx-text-fill:rgba(245,245,244,0.5); -fx-font-weight:600;" text="Analyse Groq AI • Llama 4 Scout 17B" />
                
                <!-- Risk distribution with animated bars -->
                <VBox fx:id="riskSummaryBox" spacing="8">
                    <Label style="-fx-text-fill:rgba(245,245,244,0.4); -fx-font-size:11; -fx-font-style:italic;" text="Chargement de l'analyse IA..." />
                </VBox>

                <!-- AI Insights section -->
                <VBox fx:id="aiInsightsBox" spacing="6" style="-fx-background-color:rgba(0,0,0,0.2); -fx-background-radius:10; -fx-padding:10;">
                    <Label style="-fx-font-size:10; -fx-text-fill:rgba(245,245,244,0.6); -fx-font-weight:700;" text="💡 INSIGHTS IA" />
                    <Label fx:id="labelAiInsight" style="-fx-font-size:9; -fx-text-fill:rgba(245,245,244,0.5); -fx-wrap-text:true;" text="Analyse en cours..." />
                </VBox>

                <Button fx:id="btnViewAllRisk" onAction="#onViewAllRisk"
                        style="-fx-background-color:linear-gradient(to right, rgba(139,92,246,0.3), rgba(109,40,217,0.3));
                               -fx-text-fill:#c4b5fd; -fx-font-size:11; -fx-font-weight:700; -fx-padding:8 16 8 16;
                               -fx-background-radius:10; -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(139,92,246,0.4),8,0,0,2);" text="📋 Voir analyse complète →" />
            </VBox>

        </HBox>

        <Region prefHeight="18" />

        <!-- ══ AI PREDICTIONS & TRENDS ROW ══ -->
        <HBox spacing="14">

            <!-- Engagement Trend Chart -->
            <VBox spacing="12" prefWidth="400"
                  style="-fx-background-color:linear-gradient(to bottom, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
                         -fx-background-radius:20; -fx-border-color:rgba(255,255,255,0.12); -fx-border-radius:20;
                         -fx-padding:18 20 18 20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.4),16,0.2,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:15; -fx-font-weight:700; -fx-text-fill:white; -fx-effect:dropshadow(gaussian,rgba(255,255,255,0.3),4,0,0,1);" text="📈 Tendance d'engagement" />
                    <Label style="-fx-font-size:11; -fx-text-fill:rgba(245,245,244,0.5); -fx-background-color:rgba(255,255,255,0.1);
                                  -fx-background-radius:8; -fx-padding:3 10 3 10; -fx-font-weight:600;" text="7 derniers jours" />
                </HBox>
                <Canvas fx:id="trendCanvas" height="100" width="360" />
                <HBox spacing="16">
                    <VBox spacing="2">
                        <Label style="-fx-font-size:9; -fx-text-fill:rgba(245,245,244,0.4);" text="Moyenne" />
                        <Label fx:id="labelAvgEngagement" style="-fx-font-size:13; -fx-text-fill:#34d399; -fx-font-weight:700;" text="0%" />
                    </VBox>
                    <VBox spacing="2">
                        <Label style="-fx-font-size:9; -fx-text-fill:rgba(245,245,244,0.4);" text="Tendance" />
                        <Label fx:id="labelTrendDirection" style="-fx-font-size:13; -fx-text-fill:#fbbf24; -fx-font-weight:700;" text="→" />
                    </VBox>
                </HBox>
            </VBox>

            <!-- AI Recommendations -->
            <VBox spacing="12" HBox.hgrow="ALWAYS"
                  style="-fx-background-color:linear-gradient(to bottom, rgba(16,185,129,0.08), rgba(5,150,105,0.04));
                         -fx-background-radius:20; -fx-border-color:rgba(16,185,129,0.25); -fx-border-radius:20;
                         -fx-padding:18 20 18 20; -fx-effect:dropshadow(gaussian,rgba(16,185,129,0.3),16,0.2,0,6);">
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label style="-fx-font-size:15; -fx-font-weight:700; -fx-text-fill:white; -fx-effect:dropshadow(gaussian,rgba(255,255,255,0.3),4,0,0,1);" text="🎯 Recommandations IA" />
                </HBox>
                <VBox fx:id="recommendationsBox" spacing="8">
                    <Label style="-fx-text-fill:rgba(245,245,244,0.4); -fx-font-size:11; -fx-font-style:italic;" text="Génération des recommandations..." />
                </VBox>
            </VBox>

        </HBox>

        <Region prefHeight="18" />

        <!-- ══ QUICK ACTIONS CARD ══ -->
        <VBox spacing="14"
              style="-fx-background-color:linear-gradient(to bottom, rgba(255,255,255,0.06), rgba(255,255,255,0.03));
                     -fx-background-radius:20; -fx-border-color:rgba(255,255,255,0.12); -fx-border-radius:20;
                     -fx-padding:18 20 18 20; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.4),16,0.2,0,6);">
            <Label style="-fx-font-size:15; -fx-font-weight:700; -fx-text-fill:white; -fx-effect:dropshadow(gaussian,rgba(255,255,255,0.3),4,0,0,1);" text="⚡ Actions rapides" />
            <HBox spacing="12">
                <Button onAction="#onGoToUsers"
                        style="-fx-background-color:linear-gradient(to bottom right, #34d399, #059669);
                               -fx-text-fill:white; -fx-font-weight:700; -fx-font-size:12;
                               -fx-padding:12 24 12 24; -fx-background-radius:14; -fx-cursor:hand;
                               -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(5,150,105,0.6),12,0.3,0,4);" text="👥  Gérer les utilisateurs" />
                <Button onAction="#onGoToActivites"
                        style="-fx-background-color:rgba(139,92,246,0.25); -fx-text-fill:#c4b5fd;
                               -fx-font-size:12; -fx-font-weight:700; -fx-padding:12 24 12 24;
                               -fx-background-radius:14; -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(139,92,246,0.4),8,0.2,0,3);" text="📊  Voir les activités" />
                <Button onAction="#onRefreshDashboard"
                        style="-fx-background-color:rgba(251,191,36,0.25); -fx-text-fill:#fbbf24;
                               -fx-font-size:12; -fx-font-weight:700; -fx-padding:12 24 12 24;
                               -fx-background-radius:14; -fx-cursor:hand; -fx-border-width:0;
                               -fx-effect:dropshadow(gaussian,rgba(251,191,36,0.4),8,0.2,0,3);" text="🔄  Actualiser" />
            </HBox>
        </VBox>

        <!-- EXTRA BOTTOM SPACE FOR SCROLLING -->
        <Region prefHeight="150" />

    </VBox>
</ScrollPane>
