<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.RetentionController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color:#0a0f0d;">

    <center>
        <ScrollPane fitToWidth="true" fitToHeight="false"
                    hbarPolicy="NEVER" vbarPolicy="AS_NEEDED"
                    style="-fx-background-color:#0a0f0d; -fx-background:transparent; -fx-border-width:0;">
        <VBox spacing="20" style="-fx-padding:30; -fx-background-color:#0a0f0d;">

            <!-- Header -->
            <VBox spacing="4">
                <Label text="📊 ANALYSE DE RÉTENTION"
                       style="-fx-font-size:12; -fx-font-weight:700; -fx-text-fill:#7a6ad8;
                              -fx-background-color:rgba(122,106,216,0.15); -fx-background-radius:20; -fx-padding:3 12 3 12;"/>
                <Label text="Analyse de rétention des étudiants (Cohorte Analysis)"
                       style="-fx-font-size:24; -fx-font-weight:800; -fx-text-fill:white;"/>
                <Label text="Suivez l'évolution de la fidélisation des étudiants mois par mois"
                       style="-fx-font-size:13; -fx-text-fill:rgba(245,245,244,0.5);"/>
            </VBox>

            <!-- Cartes de résumé -->
            <HBox spacing="20" alignment="CENTER">
                <VBox spacing="5" alignment="CENTER" prefWidth="200" prefHeight="90"
                      style="-fx-background-color:rgba(255,255,255,0.05); -fx-background-radius:12; -fx-border-color:rgba(255,255,255,0.1); -fx-border-radius:12; -fx-padding:15;">
                    <Label text="👥 TOTAL ÉTUDIANTS" style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(245,245,244,0.5);"/>
                    <Label fx:id="totalEtudiants" text="0" style="-fx-font-size:32; -fx-font-weight:800; -fx-text-fill:#7a6ad8;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" prefWidth="200" prefHeight="90"
                      style="-fx-background-color:rgba(255,255,255,0.05); -fx-background-radius:12; -fx-border-color:rgba(255,255,255,0.1); -fx-border-radius:12; -fx-padding:15;">
                    <Label text="📈 RÉTENTION 1 MOIS" style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(245,245,244,0.5);"/>
                    <Label fx:id="retention1Mois" text="0%" style="-fx-font-size:28; -fx-font-weight:800; -fx-text-fill:#34d399;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" prefWidth="200" prefHeight="90"
                      style="-fx-background-color:rgba(255,255,255,0.05); -fx-background-radius:12; -fx-border-color:rgba(255,255,255,0.1); -fx-border-radius:12; -fx-padding:15;">
                    <Label text="📊 RÉTENTION 3 MOIS" style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(245,245,244,0.5);"/>
                    <Label fx:id="retention3Mois" text="0%" style="-fx-font-size:28; -fx-font-weight:800; -fx-text-fill:#fbbf24;"/>
                </VBox>
                <VBox spacing="5" alignment="CENTER" prefWidth="200" prefHeight="90"
                      style="-fx-background-color:rgba(255,255,255,0.05); -fx-background-radius:12; -fx-border-color:rgba(255,255,255,0.1); -fx-border-radius:12; -fx-padding:15;">
                    <Label text="🎯 RÉTENTION 6 MOIS" style="-fx-font-size:11; -fx-font-weight:700; -fx-text-fill:rgba(245,245,244,0.5);"/>
                    <Label fx:id="retention6Mois" text="0%" style="-fx-font-size:28; -fx-font-weight:800; -fx-text-fill:#f87171;"/>
                </VBox>
            </HBox>

            <!-- Filtre par cohorte -->
            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Filtrer par cohorte :"
                       style="-fx-font-size:13; -fx-font-weight:600; -fx-text-fill:rgba(245,245,244,0.7);"/>
                <ComboBox fx:id="cohorteFilter" promptText="Toutes les cohortes"
                          style="-fx-background-color:rgba(255,255,255,0.08); -fx-border-color:rgba(255,255,255,0.15);
                                 -fx-border-radius:8; -fx-background-radius:8; -fx-padding:8 15; -fx-font-size:13; -fx-text-fill:white;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="🔄 Actualiser" onAction="#refreshData"
                        style="-fx-background-color:#059669; -fx-text-fill:white; -fx-font-size:12;
                               -fx-font-weight:bold; -fx-padding:8 16 8 16; -fx-background-radius:8;
                               -fx-cursor:hand; -fx-border-width:0;"/>
            </HBox>

            <!-- Tableau de rétention (Heatmap) -->
            <VBox spacing="0"
                  style="-fx-background-color:rgba(255,255,255,0.03); -fx-background-radius:12;
                         -fx-border-color:rgba(255,255,255,0.08); -fx-border-radius:12;">

                <!-- En-tête -->
                <HBox spacing="8" alignment="CENTER_LEFT"
                      style="-fx-padding:16 20 12 20; -fx-border-color:transparent transparent rgba(255,255,255,0.08) transparent; -fx-border-width:0 0 1 0;">
                    <Label text="COHORTE (Mois d'inscription)" prefWidth="150" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 0" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 1" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 2" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 3" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 4" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                    <Label text="Mois 5" prefWidth="100" style="-fx-text-fill:rgba(245,245,244,0.5); -fx-font-size:12; -fx-font-weight:bold;"/>
                </HBox>

                <!-- Conteneur des lignes -->
                <VBox fx:id="retentionContainer" spacing="1" style="-fx-padding:4 0 4 0;"/>

                <!-- Message vide -->
                <Label fx:id="emptyLabel" text="Aucune donnée de rétention disponible"
                       style="-fx-text-fill:rgba(245,245,244,0.3); -fx-font-size:13; -fx-padding:40; -fx-alignment:center;"
                       visible="false" managed="false"/>
            </VBox>

        </VBox>
        </ScrollPane>
    </center>

    <!-- -- EXTRA BOTTOM SPACE FOR SCROLLING -- -->
    <Region prefHeight="150" />

</BorderPane>