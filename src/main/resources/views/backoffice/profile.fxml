<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.ProfileController"
            style="-fx-background-color:#0d1117;">

    <center>
        <ScrollPane fitToWidth="true"
                    style="-fx-background-color:#0d1117;
                           -fx-background:transparent; -fx-border-width:0;">
            <VBox spacing="0" style="-fx-background-color:#0d1117;">

                <!-- ═══ HERO BANNER ═══ -->
                <HBox alignment="CENTER_LEFT" spacing="20"
                      style="-fx-background-color:linear-gradient(to right,#161b22,#21262d);
                             -fx-padding:28 40 28 40;
                             -fx-border-color:transparent transparent #30363d transparent;
                             -fx-border-width:0 0 1 0;">

                    <!-- Avatar circle -->
                    <StackPane minWidth="80" minHeight="80" prefWidth="80" prefHeight="80">
                        <Circle radius="40"
                                style="-fx-fill:#059669;"/>
                        <Label fx:id="labelInitials" text=""
                               style="-fx-text-fill:white; -fx-font-size:26; -fx-font-weight:900;"/>
                        <javafx.scene.image.ImageView fx:id="avatarImageView"
                               fitWidth="80" fitHeight="80"
                               preserveRatio="false" visible="false" managed="false">
                            <clip><Circle radius="40" centerX="40" centerY="40"/></clip>
                        </javafx.scene.image.ImageView>
                    </StackPane>

                    <!-- Name + email + badges -->
                    <VBox spacing="6" HBox.hgrow="ALWAYS">
                        <Label fx:id="labelFullName" text=""
                               style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:#e6edf3;"/>
                        <Label fx:id="labelEmailHeader" text=""
                               style="-fx-font-size:12; -fx-text-fill:#8b949e;"/>
                        <HBox spacing="8" alignment="CENTER_LEFT">
                            <Label fx:id="labelRole" text=""
                                   style="-fx-background-color:rgba(5,150,105,0.2);
                                          -fx-text-fill:#34d399; -fx-background-radius:20;
                                          -fx-padding:3 12 3 12; -fx-font-size:11; -fx-font-weight:700;"/>
                            <Label fx:id="labelNiveauBadge" text=""
                                   style="-fx-background-color:rgba(251,191,36,0.2);
                                          -fx-text-fill:#fbbf24; -fx-background-radius:20;
                                          -fx-padding:3 12 3 12; -fx-font-size:11; -fx-font-weight:700;"
                                   visible="false" managed="false"/>
                        </HBox>
                    </VBox>

                    <!-- Security score -->
                    <VBox alignment="CENTER" spacing="2"
                          style="-fx-background-color:rgba(5,150,105,0.1);
                                 -fx-border-color:rgba(5,150,105,0.3);
                                 -fx-border-width:1; -fx-border-radius:12;
                                 -fx-background-radius:12; -fx-padding:14 22 14 22;">
                        <Label fx:id="labelSecurityScore" text="—"
                               style="-fx-font-size:26; -fx-font-weight:900; -fx-text-fill:#34d399;"/>
                        <Label text="Score securite"
                               style="-fx-font-size:10; -fx-text-fill:#8b949e;"/>
                        <Label fx:id="labelSecurityText" text=""
                               style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#34d399;"/>
                    </VBox>
                </HBox>

                <!-- ═══ MAIN CONTENT: 2 columns ═══ -->
                <HBox spacing="16" alignment="TOP_CENTER"
                      style="-fx-padding:20 40 32 40; -fx-background-color:#0d1117;">

                    <!-- LEFT COLUMN -->
                    <VBox spacing="14" HBox.hgrow="ALWAYS" maxWidth="500">

                        <!-- Success label -->
                        <Label fx:id="successLabel" text="" wrapText="true"
                               style="-fx-background-color:rgba(5,150,105,0.15);
                                      -fx-border-color:rgba(5,150,105,0.4);
                                      -fx-border-width:0 0 0 3;
                                      -fx-border-radius:6; -fx-background-radius:6;
                                      -fx-text-fill:#34d399; -fx-font-size:12;
                                      -fx-font-weight:700; -fx-padding:10 14 10 14;"
                               visible="false" managed="false"/>

                        <!-- Personal Info Card -->
                        <VBox spacing="0"
                              style="-fx-background-color:#161b22;
                                     -fx-background-radius:12;
                                     -fx-border-color:#30363d; -fx-border-radius:12;
                                     -fx-border-width:1;">
                            <HBox style="-fx-padding:14 18 10 18;
                                         -fx-border-color:transparent transparent #30363d transparent;
                                         -fx-border-width:0 0 1 0;">
                                <Label text="Informations personnelles"
                                       style="-fx-font-size:13; -fx-font-weight:700;
                                              -fx-text-fill:#e6edf3;"/>
                            </HBox>
                            <VBox spacing="12" style="-fx-padding:14 18 18 18;">
                                <HBox spacing="12">
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Prenom"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e;"/>
                                        <TextField fx:id="fieldPrenom"
                                                   style="-fx-background-color:#21262d;
                                                          -fx-border-color:#30363d;
                                                          -fx-border-radius:8; -fx-background-radius:8;
                                                          -fx-padding:8 12 8 12; -fx-font-size:13;
                                                          -fx-text-fill:#e6edf3;
                                                          -fx-prompt-text-fill:#484f58;"/>
                                        <Label fx:id="errorPrenom"
                                               style="-fx-text-fill:#f85149; -fx-font-size:10;" minHeight="10"/>
                                    </VBox>
                                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                                        <Label text="Nom"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e;"/>
                                        <TextField fx:id="fieldNom"
                                                   style="-fx-background-color:#21262d;
                                                          -fx-border-color:#30363d;
                                                          -fx-border-radius:8; -fx-background-radius:8;
                                                          -fx-padding:8 12 8 12; -fx-font-size:13;
                                                          -fx-text-fill:#e6edf3;
                                                          -fx-prompt-text-fill:#484f58;"/>
                                        <Label fx:id="errorNom"
                                               style="-fx-text-fill:#f85149; -fx-font-size:10;" minHeight="10"/>
                                    </VBox>
                                </HBox>
                                <VBox spacing="4">
                                    <Label text="Adresse email"
                                           style="-fx-font-size:11; -fx-font-weight:600;
                                                  -fx-text-fill:#8b949e;"/>
                                    <TextField fx:id="fieldEmail"
                                               style="-fx-background-color:#21262d;
                                                      -fx-border-color:#30363d;
                                                      -fx-border-radius:8; -fx-background-radius:8;
                                                      -fx-padding:8 12 8 12; -fx-font-size:13;
                                                      -fx-text-fill:#e6edf3;
                                                      -fx-prompt-text-fill:#484f58;"/>
                                    <Label fx:id="errorEmail"
                                           style="-fx-text-fill:#f85149; -fx-font-size:10;" minHeight="10"/>
                                </VBox>
                                <!-- Role display -->
                                <HBox spacing="8" alignment="CENTER_LEFT"
                                      style="-fx-background-color:#21262d;
                                             -fx-border-color:#30363d;
                                             -fx-border-radius:8; -fx-background-radius:8;
                                             -fx-padding:8 12 8 12;">
                                    <Label fx:id="labelRoleDisplay" text=""
                                           style="-fx-font-size:13; -fx-font-weight:700;
                                                  -fx-text-fill:#34d399;"/>
                                    <Label text="(non modifiable)"
                                           style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
                                </HBox>
                                <!-- Niveau (students only) -->
                                <VBox fx:id="labelNiveauRow" spacing="4"
                                      visible="false" managed="false">
                                    <Label text="Niveau"
                                           style="-fx-font-size:11; -fx-font-weight:600;
                                                  -fx-text-fill:#8b949e;"/>
                                    <ComboBox fx:id="comboNiveau" maxWidth="Infinity"
                                              style="-fx-background-color:#21262d;
                                                     -fx-border-color:#30363d;
                                                     -fx-border-radius:8; -fx-background-radius:8;
                                                     -fx-font-size:13;"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- Password Card -->
                        <VBox spacing="0"
                              style="-fx-background-color:#161b22;
                                     -fx-background-radius:12;
                                     -fx-border-color:#30363d; -fx-border-radius:12;
                                     -fx-border-width:1;">
                            <HBox style="-fx-padding:14 18 10 18;
                                         -fx-border-color:transparent transparent #30363d transparent;
                                         -fx-border-width:0 0 1 0;">
                                <Label text="Changer le mot de passe"
                                       style="-fx-font-size:13; -fx-font-weight:700;
                                              -fx-text-fill:#e6edf3;"/>
                            </HBox>
                            <VBox spacing="12" style="-fx-padding:14 18 18 18;">
                                <VBox spacing="4">
                                    <Label text="Nouveau mot de passe"
                                           style="-fx-font-size:11; -fx-font-weight:600;
                                                  -fx-text-fill:#8b949e;"/>
                                    <PasswordField fx:id="fieldPassword"
                                                   promptText="Laisser vide pour ne pas changer"
                                                   style="-fx-background-color:#21262d;
                                                          -fx-border-color:#30363d;
                                                          -fx-border-radius:8; -fx-background-radius:8;
                                                          -fx-padding:8 12 8 12; -fx-font-size:13;
                                                          -fx-text-fill:#e6edf3;
                                                          -fx-prompt-text-fill:#484f58;"/>
                                    <Label fx:id="errorPassword"
                                           style="-fx-text-fill:#f85149; -fx-font-size:10;" minHeight="10"/>
                                </VBox>
                                <VBox spacing="4">
                                    <Label text="Confirmer"
                                           style="-fx-font-size:11; -fx-font-weight:600;
                                                  -fx-text-fill:#8b949e;"/>
                                    <PasswordField fx:id="fieldConfirmPassword"
                                                   promptText="Confirmer le mot de passe"
                                                   style="-fx-background-color:#21262d;
                                                          -fx-border-color:#30363d;
                                                          -fx-border-radius:8; -fx-background-radius:8;
                                                          -fx-padding:8 12 8 12; -fx-font-size:13;
                                                          -fx-text-fill:#e6edf3;
                                                          -fx-prompt-text-fill:#484f58;"/>
                                    <Label fx:id="errorConfirmPassword"
                                           style="-fx-text-fill:#f85149; -fx-font-size:10;" minHeight="10"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- Save Button -->
                        <Button text="Enregistrer les modifications" onAction="#onSave"
                                maxWidth="Infinity"
                                style="-fx-background-color:#059669; -fx-text-fill:white;
                                       -fx-font-size:13; -fx-font-weight:700;
                                       -fx-padding:11 0 11 0; -fx-background-radius:10;
                                       -fx-cursor:hand; -fx-border-width:0;"/>

                        <!-- Face ID Button -->
                        <Button fx:id="btnFaceId" onAction="#onFaceIdRegister"
                                maxWidth="Infinity"
                                style="-fx-background-color:rgba(5,150,105,0.1);
                                       -fx-text-fill:#34d399; -fx-font-size:13;
                                       -fx-font-weight:700; -fx-padding:11 0 11 0;
                                       -fx-background-radius:10; -fx-cursor:hand;
                                       -fx-border-width:1;
                                       -fx-border-color:rgba(5,150,105,0.3);
                                       -fx-border-radius:10;"/>
                    </VBox>

                    <!-- RIGHT COLUMN -->
                    <VBox spacing="14" prefWidth="340" minWidth="300" maxWidth="360">

                        <!-- Security Card -->
                        <VBox spacing="0"
                              style="-fx-background-color:#161b22;
                                     -fx-background-radius:12;
                                     -fx-border-color:#30363d; -fx-border-radius:12;
                                     -fx-border-width:1;">
                            <HBox style="-fx-padding:14 18 10 18;
                                         -fx-border-color:transparent transparent #30363d transparent;
                                         -fx-border-width:0 0 1 0;">
                                <Label text="Securite du compte"
                                       style="-fx-font-size:13; -fx-font-weight:700;
                                              -fx-text-fill:#e6edf3;"/>
                            </HBox>
                            <VBox spacing="10" style="-fx-padding:14 18 18 18;">
                                <Label fx:id="labelChainStatus" text=""
                                       style="-fx-font-size:12; -fx-font-weight:600;
                                              -fx-text-fill:#34d399;" wrapText="true"/>
                                <Label text="Vos modifications sont protegees et verifiables."
                                       style="-fx-font-size:11; -fx-text-fill:#484f58;"
                                       wrapText="true"/>
                                <VBox spacing="6" style="-fx-padding:8 0 0 0;">
                                    <Label text="Conseils :"
                                           style="-fx-font-size:11; -fx-font-weight:600;
                                                  -fx-text-fill:#8b949e;"/>
                                    <Label text="  Changez votre mot de passe regulierement"
                                           style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
                                    <Label text="  Activez Face ID pour plus de securite"
                                           style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
                                    <Label text="  Verifiez votre email regulierement"
                                           style="-fx-font-size:11; -fx-text-fill:#484f58;"/>
                                </VBox>
                            </VBox>
                        </VBox>

                        <!-- Geo Location Card -->
                        <VBox spacing="0"
                              style="-fx-background-color:#161b22;
                                     -fx-background-radius:12;
                                     -fx-border-color:#30363d; -fx-border-radius:12;
                                     -fx-border-width:1;">
                            <HBox style="-fx-padding:14 18 10 18;
                                         -fx-border-color:transparent transparent #30363d transparent;
                                         -fx-border-width:0 0 1 0;">
                                <Label text="Lieu de connexion actuel"
                                       style="-fx-font-size:13; -fx-font-weight:700;
                                              -fx-text-fill:#e6edf3;"/>
                            </HBox>
                            <VBox spacing="10" style="-fx-padding:14 18 18 18;">
                                <Label fx:id="labelGeoLoading" text="Localisation en cours..."
                                       style="-fx-font-size:12; -fx-text-fill:#484f58;"/>
                                <VBox fx:id="geoInfoBox" spacing="10"
                                      visible="false" managed="false">
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Ville"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e; -fx-min-width:65;"/>
                                        <Label fx:id="labelGeoCity" text=""
                                               style="-fx-font-size:13; -fx-font-weight:700;
                                                      -fx-text-fill:#e6edf3;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Pays"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e; -fx-min-width:65;"/>
                                        <Label fx:id="labelGeoCountry" text=""
                                               style="-fx-font-size:13; -fx-font-weight:700;
                                                      -fx-text-fill:#e6edf3;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Adresse IP"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e; -fx-min-width:65;"/>
                                        <Label fx:id="labelGeoIp" text=""
                                               style="-fx-font-size:12; -fx-text-fill:#8b949e;
                                                      -fx-font-family:monospace;"/>
                                    </HBox>
                                    <HBox spacing="10" alignment="CENTER_LEFT">
                                        <Label text="Reseau"
                                               style="-fx-font-size:11; -fx-font-weight:600;
                                                      -fx-text-fill:#8b949e; -fx-min-width:65;"/>
                                        <Label fx:id="labelGeoIsp" text=""
                                               style="-fx-font-size:11; -fx-text-fill:#484f58;"
                                               wrapText="true"/>
                                    </HBox>
                                </VBox>
                                <Label fx:id="labelGeoError" text=""
                                       style="-fx-font-size:11; -fx-text-fill:#484f58;"
                                       visible="false" managed="false" wrapText="true"/>
                            </VBox>
                        </VBox>

                        <!-- Blockchain History Card -->
                        <VBox spacing="0"
                              style="-fx-background-color:#161b22;
                                     -fx-background-radius:12;
                                     -fx-border-color:#30363d; -fx-border-radius:12;
                                     -fx-border-width:1;">
                            <HBox style="-fx-padding:14 18 10 18;
                                         -fx-border-color:transparent transparent #30363d transparent;
                                         -fx-border-width:0 0 1 0;">
                                <Label text="Historique des modifications"
                                       style="-fx-font-size:13; -fx-font-weight:700;
                                              -fx-text-fill:#e6edf3;"/>
                                <Region HBox.hgrow="ALWAYS"/>
                                <Label text="Protege et immuable"
                                       style="-fx-font-size:10; -fx-text-fill:#484f58;"/>
                            </HBox>
                            <VBox fx:id="blockchainHistoryBox" spacing="8"
                                  style="-fx-padding:12 18 16 18;"/>
                        </VBox>

                    </VBox>
                </HBox>
            </VBox>
        </ScrollPane>
    </center>

    <!-- -- EXTRA BOTTOM SPACE FOR SCROLLING -- -->
    <Region prefHeight="150" />

</BorderPane>