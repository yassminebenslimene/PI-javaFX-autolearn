<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="tn.esprit.controllers.UserRiskAnalysisController"
            prefWidth="1280" prefHeight="760"
            style="-fx-background-color:#0a0f0d;">

    <top>
        <!-- Header -->
        <VBox spacing="8" style="-fx-background-color:#0d1a14; -fx-padding:24 32 20 32;
                                 -fx-border-color:transparent transparent rgba(255,255,255,0.08) transparent; -fx-border-width:0 0 1 0;">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <Label text="🤖" style="-fx-font-size:28;"/>
                <VBox spacing="3">
                    <Label text="Analyse IA — Risque d'abandon étudiant"
                           style="-fx-font-size:24; -fx-font-weight:800; -fx-text-fill:white;"/>
                    <Label text="Analyse complète des utilisateurs avec risque de suspension"
                           style="-fx-font-size:13; -fx-text-fill:rgba(245,245,244,0.5);"/>
                </VBox>
            </HBox>

            <!-- Risk Summary Stats -->
            <HBox spacing="16" style="-fx-padding:16 0 0 0;">
                <VBox spacing="4" style="-fx-background-color:rgba(220,38,38,0.15); -fx-background-radius:10; -fx-padding:12 16 12 16;">
                    <Label text="🔴 CRITIQUE" style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#fca5a5;"/>
                    <Label fx:id="labelCritique" text="0" style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:#dc2626;"/>
                    <Label fx:id="labelCritiquePercent" text="0%" style="-fx-font-size:11; -fx-text-fill:rgba(252,165,165,0.7);"/>
                </VBox>

                <VBox spacing="4" style="-fx-background-color:rgba(249,115,22,0.15); -fx-background-radius:10; -fx-padding:12 16 12 16;">
                    <Label text="🟠 ÉLEVÉ" style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#fdba74;"/>
                    <Label fx:id="labelEleve" text="0" style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:#f97316;"/>
                    <Label fx:id="labelElevePercent" text="0%" style="-fx-font-size:11; -fx-text-fill:rgba(253,186,116,0.7);"/>
                </VBox>

                <VBox spacing="4" style="-fx-background-color:rgba(245,158,11,0.15); -fx-background-radius:10; -fx-padding:12 16 12 16;">
                    <Label text="🟡 MOYEN" style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#fcd34d;"/>
                    <Label fx:id="labelMoyen" text="0" style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:#f59e0b;"/>
                    <Label fx:id="labelMoyenPercent" text="0%" style="-fx-font-size:11; -fx-text-fill:rgba(252,211,77,0.7);"/>
                </VBox>

                <VBox spacing="4" style="-fx-background-color:rgba(16,185,129,0.15); -fx-background-radius:10; -fx-padding:12 16 12 16;">
                    <Label text="🟢 FAIBLE" style="-fx-font-size:10; -fx-font-weight:700; -fx-text-fill:#6ee7b7;"/>
                    <Label fx:id="labelFaible" text="0" style="-fx-font-size:22; -fx-font-weight:800; -fx-text-fill:#10b981;"/>
                    <Label fx:id="labelFaiblePercent" text="0%" style="-fx-font-size:11; -fx-text-fill:rgba(110,231,183,0.7);"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox spacing="4" alignment="CENTER_RIGHT">
                    <Label text="Powered by Groq AI" style="-fx-font-size:11; -fx-text-fill:rgba(245,245,244,0.4);"/>
                    <Label text="Llama 4 Scout 17B" style="-fx-font-size:10; -fx-text-fill:rgba(245,245,244,0.3);"/>
                </VBox>
            </HBox>
        </VBox>
    </top>

    <center>
        <!-- Users List -->
        <ScrollPane fitToWidth="true" style="-fx-background-color:transparent; -fx-background:transparent; -fx-border-width:0;">
            <VBox fx:id="usersContainer" spacing="8" style="-fx-padding:24 32 150 32; -fx-background-color:#0a0f0d;"/>
        </ScrollPane>
    </center>

</BorderPane>
