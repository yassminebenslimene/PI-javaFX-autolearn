<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="0" style="-fx-background-color:#0a0f0d;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="tn.esprit.controllers.UserController">
    <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>

    <!-- ══ ANIMATED STATS ROW ══ -->
    <HBox alignment="CENTER_LEFT" spacing="14">

        <!-- Total Users -->
        <VBox fx:id="cardTotal" prefHeight="88" prefWidth="185" spacing="4"
              style="-fx-background-color:rgba(52,211,153,0.08); -fx-background-radius:16;
                     -fx-border-color:rgba(52,211,153,0.25); -fx-border-radius:16;
                     -fx-padding:14 16 14 16; -fx-effect:dropshadow(gaussian,rgba(52,211,153,0.15),14,0,0,4);">
            <HBox alignment="CENTER_LEFT" spacing="0">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size:10; -fx-text-fill:rgba(52,211,153,0.7); -fx-font-weight:700; -fx-letter-spacing:1;" text="TOTAL USERS" />
                    <Label fx:id="labelTotalUsers" style="-fx-font-size:30; -fx-font-weight:900; -fx-text-fill:#34d399;" text="0" />
                </VBox>
                <Label style="-fx-font-size:26; -fx-background-color:rgba(52,211,153,0.15);
                              -fx-background-radius:12; -fx-padding:8 10 8 10;" text="👥" />
            </HBox>
            <Label fx:id="labelActiveWeek" style="-fx-font-size:10; -fx-text-fill:rgba(52,211,153,0.6);" text="— actifs cette semaine" />
        </VBox>

        <!-- Etudiants -->
        <VBox fx:id="cardEtudiants" prefHeight="88" prefWidth="185" spacing="4"
              style="-fx-background-color:rgba(251,191,36,0.08); -fx-background-radius:16;
                     -fx-border-color:rgba(251,191,36,0.25); -fx-border-radius:16;
                     -fx-padding:14 16 14 16; -fx-effect:dropshadow(gaussian,rgba(251,191,36,0.15),14,0,0,4);">
            <HBox alignment="CENTER_LEFT" spacing="0">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size:10; -fx-text-fill:rgba(251,191,36,0.7); -fx-font-weight:700; -fx-letter-spacing:1;" text="ÉTUDIANTS" />
                    <Label fx:id="labelTotalEtudiants" style="-fx-font-size:30; -fx-font-weight:900; -fx-text-fill:#fbbf24;" text="0" />
                </VBox>
                <Label style="-fx-font-size:26; -fx-background-color:rgba(251,191,36,0.15);
                              -fx-background-radius:12; -fx-padding:8 10 8 10;" text="🎓" />
            </HBox>
            <Label fx:id="labelNewWeek" style="-fx-font-size:10; -fx-text-fill:rgba(251,191,36,0.6);" text="— nouveaux cette semaine" />
        </VBox>

        <!-- Admins -->
        <VBox fx:id="cardAdmins" prefHeight="88" prefWidth="185" spacing="4"
              style="-fx-background-color:rgba(248,113,113,0.08); -fx-background-radius:16;
                     -fx-border-color:rgba(248,113,113,0.25); -fx-border-radius:16;
                     -fx-padding:14 16 14 16; -fx-effect:dropshadow(gaussian,rgba(248,113,113,0.15),14,0,0,4);">
            <HBox alignment="CENTER_LEFT" spacing="0">
                <VBox spacing="2" HBox.hgrow="ALWAYS">
                    <Label style="-fx-font-size:10; -fx-text-fill:rgba(248,113,113,0.7); -fx-font-weight:700; -fx-letter-spacing:1;" text="ADMINS" />
                    <Label fx:id="labelTotalAdmins" style="-fx-font-size:30; -fx-font-weight:900; -fx-text-fill:#f87171;" text="0" />
                </VBox>
                <Label style="-fx-font-size:26; -fx-background-color:rgba(248,113,113,0.15);
                              -fx-background-radius:12; -fx-padding:8 10 8 10;" text="🛡" />
            </HBox>
            <Label fx:id="labelSuspended" style="-fx-font-size:10; -fx-text-fill:rgba(248,113,113,0.6);" text="— suspendus" />
        </VBox>

        <Region HBox.hgrow="ALWAYS" />
        <HBox fx:id="adminToolbarNew" alignment="CENTER" />
    </HBox>

    <Region prefHeight="14" />

    <!-- ══ HEATMAP + AI RISK ROW ══ -->
    <HBox spacing="14">

        <!-- Activity Heatmap Card -->
        <VBox spacing="10" HBox.hgrow="ALWAYS"
              style="-fx-background-color:rgba(255,255,255,0.04); -fx-background-radius:18;
                     -fx-border-color:rgba(255,255,255,0.09); -fx-border-radius:18;
                     -fx-padding:16 18 16 18; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.3),12,0,0,4);">
            <HBox alignment="CENTER_LEFT" spacing="10">
                <Label style="-fx-font-size:14; -fx-font-weight:700; -fx-text-fill:white;" text="Activité par heure" />
                <Label style="-fx-font-size:11; -fx-text-fill:rgba(245,245,244,0.4); -fx-background-color:rgba(255,255,255,0.07);
                              -fx-background-radius:6; -fx-padding:2 8 2 8;" text="Connexions / 24h" />
            </HBox>
            <!-- Canvas drawn by controller -->
            <Canvas fx:id="heatmapCanvas" height="90" width="520" />
            <!-- Hour labels -->
            <HBox fx:id="heatmapLabels" spacing="0" />
        </VBox>

        <!-- AI Risk Summary Card -->
        <VBox prefWidth="260" spacing="10"
              style="-fx-background-color:rgba(255,255,255,0.04); -fx-background-radius:18;
                     -fx-border-color:rgba(255,255,255,0.09); -fx-border-radius:18;
                     -fx-padding:16 18 16 18; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.3),12,0,0,4);">
            <HBox alignment="CENTER_LEFT" spacing="8">
                <Label style="-fx-font-size:14; -fx-font-weight:700; -fx-text-fill:white;" text="IA — Risque abandon" />
                <Label style="-fx-font-size:18;" text="🤖" />
            </HBox>
            <Label style="-fx-font-size:10; -fx-text-fill:rgba(245,245,244,0.4);" text="Analyse Groq AI en temps réel" />
            <VBox fx:id="riskSummaryBox" spacing="6">
                <Label style="-fx-text-fill:rgba(245,245,244,0.3); -fx-font-size:11;" text="Chargement de l'analyse IA..." />
            </VBox>
            <Button fx:id="btnViewAllRisk" onAction="#onViewAllRisk"
                    style="-fx-background-color:rgba(122,106,216,0.2); -fx-text-fill:#a5b4fc;
                           -fx-font-size:11; -fx-font-weight:700; -fx-padding:7 14 7 14;
                           -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:0;" text="Voir analyse complète →" />
        </VBox>

    </HBox>

    <Region prefHeight="14" />

    <!-- ══ TABLE CARD ══ -->
    <VBox spacing="0" style="-fx-background-color:rgba(255,255,255,0.04); -fx-background-radius:20;
                             -fx-border-color:rgba(255,255,255,0.09); -fx-border-radius:20;
                             -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.25),16,0,0,6);" VBox.vgrow="ALWAYS">

        <!-- Card header -->
        <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding:16 20 14 20;
                     -fx-border-color:transparent transparent rgba(255,255,255,0.08) transparent;
                     -fx-border-width:0 0 1 0;">
            <VBox spacing="2">
                <Label style="-fx-font-size:15; -fx-font-weight:700; -fx-text-fill:white;" text="All Users" />
                <Label style="-fx-font-size:11; -fx-text-fill:rgba(245,245,244,0.45);" text="Manage your user base" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <Button onAction="#onNewUser"
                    style="-fx-background-color:linear-gradient(to bottom right, #34d399, #059669);
                           -fx-text-fill:white; -fx-font-weight:700; -fx-font-size:12;
                           -fx-padding:10 20 10 20; -fx-background-radius:12; -fx-cursor:hand;
                           -fx-border-width:0;
                           -fx-effect:dropshadow(gaussian,rgba(5,150,105,0.5),10,0,0,3);" text="＋  Add Student" />
            <HBox alignment="CENTER" spacing="8"
                  style="-fx-background-color:rgba(255,255,255,0.07);
                         -fx-background-radius:10; -fx-border-color:rgba(255,255,255,0.12);
                         -fx-border-radius:10; -fx-padding:7 12 7 12;">
                <Label style="-fx-font-size:12; -fx-text-fill:rgba(245,245,244,0.4);" text="🔍" />
                <TextField fx:id="searchField" onKeyReleased="#onSearch" prefWidth="200"
                           promptText="Search users..."
                           style="-fx-background-color:transparent; -fx-border-width:0;
                                  -fx-font-size:13; -fx-text-fill:white;
                                  -fx-prompt-text-fill:rgba(245,245,244,0.35);" />
                <Button onAction="#onClearSearch"
                        style="-fx-background-color:transparent; -fx-text-fill:rgba(245,245,244,0.4);
                               -fx-padding:0 4 0 4; -fx-cursor:hand; -fx-border-width:0; -fx-font-size:12;" text="✕" />
            </HBox>
        </HBox>

        <!-- Table -->
        <TableView fx:id="tableUsers"
                   style="-fx-background-color:#0a0f0d; -fx-border-width:0;
                          -fx-table-cell-border-color:rgba(255,255,255,0.06);
                          -fx-background-radius:0 0 20 20;" VBox.vgrow="ALWAYS">
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
            </columnResizePolicy>
            <columns>
                <TableColumn fx:id="colUser"    minWidth="220" text="User" />
                <TableColumn fx:id="colNiveau"  minWidth="110" style="-fx-alignment:CENTER;" text="Level" />
                <TableColumn fx:id="colCreated" minWidth="100" style="-fx-alignment:CENTER;" text="Joined" />
                <TableColumn fx:id="colStatut"  minWidth="100" style="-fx-alignment:CENTER;" text="Status" />
                <TableColumn fx:id="colRisk"    minWidth="120" style="-fx-alignment:CENTER;" text="AI Risk" />
                <TableColumn fx:id="colActions" minWidth="200" sortable="false" style="-fx-alignment:CENTER;" text="Actions" />
            </columns>
            <placeholder>
                <VBox alignment="CENTER" spacing="12" style="-fx-padding:60;">
                    <Label style="-fx-font-size:44;" text="📭" />
                    <Label style="-fx-text-fill:rgba(245,245,244,0.35); -fx-font-size:14;" text="No users found." />
                </VBox>
            </placeholder>
        </TableView>
    </VBox>
</VBox>
