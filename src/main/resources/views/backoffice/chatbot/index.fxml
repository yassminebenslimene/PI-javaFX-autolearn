<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Circle?>

<BorderPane style="-fx-background-color:#0d1117;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="tn.esprit.controllers.ChatbotController">

    <!-- Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12" style="-fx-background-color:#161b22;                      -fx-padding:14 20 14 20;                      -fx-border-color:#30363d transparent transparent transparent;                      -fx-border-width:0 0 1 0;">

            <!-- AI Avatar -->
            <StackPane minHeight="36" minWidth="36" prefHeight="36" prefWidth="36">
                <javafx.scene.shape.Circle radius="18" style="-fx-fill:linear-gradient(to bottom right,#7a6ad8,#059669);" />
                <Label style="-fx-font-size:11; -fx-font-weight:900; -fx-text-fill:white;" text="AI" />
            </StackPane>

            <VBox spacing="1">
                <Label style="-fx-font-size:14; -fx-font-weight:700; -fx-text-fill:white;" text="Assistant AutoLearn" />
                <HBox alignment="CENTER_LEFT" spacing="5">
                    <javafx.scene.shape.Circle radius="4" style="-fx-fill:#10b981;" />
                    <Label fx:id="labelStatus" style="-fx-font-size:11; -fx-text-fill:#10b981;" text="En ligne" />
                </HBox>
            </VBox>

            <Region HBox.hgrow="ALWAYS" />

            <Button onAction="#onClear" style="-fx-background-color:transparent;                            -fx-text-fill:#8b949e; -fx-font-size:12;                            -fx-padding:5 12 5 12; -fx-background-radius:6;                            -fx-cursor:hand; -fx-border-width:1;                            -fx-border-color:#30363d; -fx-border-radius:6;" text="Effacer" />
        </HBox>
    </top>

    <!-- Messages -->
    <center>
        <ScrollPane fx:id="scrollPane" fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color:#0d1117;                            -fx-background:transparent; -fx-border-width:0;" vbarPolicy="AS_NEEDED">
            <VBox fx:id="messagesBox" prefHeight="424.0" prefWidth="594.0" spacing="4" style="-fx-padding:16 20 16 20; -fx-background-color:#0d1117;" />
        </ScrollPane>
    </center>

    <!-- Input -->
    <bottom>
        <VBox prefHeight="155.0" prefWidth="595.0" spacing="10" style="-fx-background-color:#161b22;                      -fx-border-color:#30363d transparent transparent transparent;                      -fx-border-width:1 0 0 0; -fx-padding:12 16 12 16;">

            <!-- Quick actions -->
            <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background-color:transparent; -fx-background:transparent;                                -fx-border-width:0; -fx-pref-height:34;" vbarPolicy="NEVER">
                <HBox fx:id="suggestionsBox" alignment="CENTER_LEFT" spacing="6">
                    <Button onAction="#onSuggestion" style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;                                    -fx-font-size:11; -fx-padding:5 10 5 10;                                    -fx-background-radius:20; -fx-cursor:hand;                                    -fx-border-width:1; -fx-border-color:#30363d;                                    -fx-border-radius:20;" text="Liste les cours" />
                    <Button onAction="#onSuggestion" style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;                                    -fx-font-size:11; -fx-padding:5 10 5 10;                                    -fx-background-radius:20; -fx-cursor:hand;                                    -fx-border-width:1; -fx-border-color:#30363d;                                    -fx-border-radius:20;" text="Liste les etudiants" />
                    <Button onAction="#onSuggestion" style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;                                    -fx-font-size:11; -fx-padding:5 10 5 10;                                    -fx-background-radius:20; -fx-cursor:hand;                                    -fx-border-width:1; -fx-border-color:#30363d;                                    -fx-border-radius:20;" text="Liste les evenements" />
                    <Button onAction="#onSuggestion" style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;                                    -fx-font-size:11; -fx-padding:5 10 5 10;                                    -fx-background-radius:20; -fx-cursor:hand;                                    -fx-border-width:1; -fx-border-color:#30363d;                                    -fx-border-radius:20;" text="Creer un cours" />
                    <Button onAction="#onSuggestion" style="-fx-background-color:#21262d; -fx-text-fill:#8b949e;                                    -fx-font-size:11; -fx-padding:5 10 5 10;                                    -fx-background-radius:20; -fx-cursor:hand;                                    -fx-border-width:1; -fx-border-color:#30363d;                                    -fx-border-radius:20;" text="Creer un evenement" />
                </HBox>
            </ScrollPane>

            <!-- Input row -->
            <HBox alignment="CENTER" spacing="8">
                <TextField fx:id="inputField" onAction="#onSend" promptText="Ecrivez un message..." style="-fx-background-color:#21262d;                                   -fx-text-fill:#e6edf3;                                   -fx-prompt-text-fill:#484f58;                                   -fx-border-color:#30363d;                                   -fx-border-radius:10; -fx-background-radius:10;                                   -fx-padding:10 14 10 14; -fx-font-size:13;" HBox.hgrow="ALWAYS" />
                <Button fx:id="btnSend" onAction="#onSend" style="-fx-background-color:#7a6ad8; -fx-text-fill:white;                                -fx-font-size:16; -fx-font-weight:900;                                -fx-min-width:40; -fx-min-height:40;                                -fx-background-radius:10; -fx-cursor:hand;                                -fx-border-width:0;" text="↑" />
            </HBox>
        <!-- EXTRA BOTTOM SPACE FOR SCROLLING -->
                <Region prefHeight="150" />

            </VBox>
    </bottom>

</BorderPane>