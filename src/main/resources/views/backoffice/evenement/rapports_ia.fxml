<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.web.WebView?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="tn.esprit.controllers.evenement.RapportsIAController"
      spacing="0" style="-fx-background-color:transparent;">

    <!-- Header -->
    <HBox alignment="CENTER_LEFT" spacing="16" style="-fx-padding:24 32 16 32;">
        <VBox spacing="4" HBox.hgrow="ALWAYS">
            <Label text="Rapports IA — Evenements"
                   style="-fx-text-fill:white; -fx-font-size:22; -fx-font-weight:bold;"/>
            <Label text="Rapports generes par IA bases sur les feedbacks etudiants reels"
                   style="-fx-text-fill:rgba(255,255,255,0.45); -fx-font-size:12;"/>
        </VBox>
    </HBox>

    <!-- Stats cards row -->
    <HBox spacing="16" style="-fx-padding:0 32 16 32;">
        <VBox fx:id="cardHackathon" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:rgba(124,58,237,0.15); -fx-background-radius:14;
                     -fx-border-color:rgba(124,58,237,0.4); -fx-border-radius:14; -fx-border-width:1;
                     -fx-padding:18 20 18 20;">
            <Label text="Hackathon" style="-fx-text-fill:#a78bfa; -fx-font-size:13; -fx-font-weight:bold;"/>
            <Label fx:id="statNoteHackathon" text="—/5"
                   style="-fx-text-fill:white; -fx-font-size:28; -fx-font-weight:bold;"/>
            <Label fx:id="statFbHackathon" text="0 feedbacks"
                   style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
            <Label fx:id="statSatHackathon" text="0% satisfaction"
                   style="-fx-text-fill:#34d399; -fx-font-size:11;"/>
        </VBox>
        <VBox fx:id="cardWorkshop" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:rgba(236,72,153,0.15); -fx-background-radius:14;
                     -fx-border-color:rgba(236,72,153,0.4); -fx-border-radius:14; -fx-border-width:1;
                     -fx-padding:18 20 18 20;">
            <Label text="Workshop" style="-fx-text-fill:#f472b6; -fx-font-size:13; -fx-font-weight:bold;"/>
            <Label fx:id="statNoteWorkshop" text="—/5"
                   style="-fx-text-fill:white; -fx-font-size:28; -fx-font-weight:bold;"/>
            <Label fx:id="statFbWorkshop" text="0 feedbacks"
                   style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
            <Label fx:id="statSatWorkshop" text="0% satisfaction"
                   style="-fx-text-fill:#34d399; -fx-font-size:11;"/>
        </VBox>
        <VBox fx:id="cardConference" spacing="6" HBox.hgrow="ALWAYS"
              style="-fx-background-color:rgba(6,182,212,0.15); -fx-background-radius:14;
                     -fx-border-color:rgba(6,182,212,0.4); -fx-border-radius:14; -fx-border-width:1;
                     -fx-padding:18 20 18 20;">
            <Label text="Conference" style="-fx-text-fill:#22d3ee; -fx-font-size:13; -fx-font-weight:bold;"/>
            <Label fx:id="statNoteConference" text="—/5"
                   style="-fx-text-fill:white; -fx-font-size:28; -fx-font-weight:bold;"/>
            <Label fx:id="statFbConference" text="0 feedbacks"
                   style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
            <Label fx:id="statSatConference" text="0% satisfaction"
                   style="-fx-text-fill:#34d399; -fx-font-size:11;"/>
        </VBox>
    </HBox>

    <!-- TabPane -->
    <TabPane fx:id="tabPane" VBox.vgrow="ALWAYS" tabClosingPolicy="UNAVAILABLE"
             style="-fx-background-color:transparent; -fx-padding:0 32 24 32; -fx-tab-min-width:160;">

        <!-- Tab 1 : Ameliorations -->
        <Tab text="Ameliorations">
            <VBox spacing="12" style="-fx-background-color:transparent; -fx-padding:16 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Rapport d'ameliorations"
                               style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                        <Label text="Analyse les feedbacks et identifie les axes d'amelioration prioritaires"
                               style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
                    </VBox>
                    <ProgressIndicator fx:id="spinAmeliorations" prefWidth="24" prefHeight="24"
                                       style="-fx-progress-color:#34d399;"/>
                    <Button fx:id="btnAmeliorations" text="⚡  Générer" onAction="#onGenererAmeliorations"
                            style="-fx-background-color:linear-gradient(to right,#059669,#34d399);
                                   -fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;
                                   -fx-padding:10 22 10 22; -fx-background-radius:10; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnPdfAmeliorations" text="📥  PDF" onAction="#onPdfAmeliorations"
                            style="-fx-background-color:rgba(5,150,105,0.25); -fx-text-fill:#34d399;
                                   -fx-font-size:11; -fx-font-weight:bold; -fx-padding:10 16 10 16;
                                   -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:1;
                                   -fx-border-color:rgba(5,150,105,0.5); -fx-border-radius:8;"/>
                </HBox>
                <WebView fx:id="webAmeliorations" VBox.vgrow="ALWAYS" prefHeight="480"/>
            </VBox>
        </Tab>

        <!-- Tab 2 : Suggestions -->
        <Tab text="Suggestions">
            <VBox spacing="12" style="-fx-background-color:transparent; -fx-padding:16 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Suggestions de nouveaux evenements"
                               style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                        <Label text="Propose 5 nouveaux evenements bases sur les themes apprecies dans les feedbacks"
                               style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
                    </VBox>
                    <ProgressIndicator fx:id="spinSuggestions" prefWidth="24" prefHeight="24"
                                       style="-fx-progress-color:#a78bfa;"/>
                    <Button fx:id="btnSuggestions" text="⚡  Générer" onAction="#onGenererSuggestions"
                            style="-fx-background-color:linear-gradient(to right,#7c3aed,#a78bfa);
                                   -fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;
                                   -fx-padding:10 22 10 22; -fx-background-radius:10; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnPdfSuggestions" text="📥  PDF" onAction="#onPdfSuggestions"
                            style="-fx-background-color:rgba(124,58,237,0.25); -fx-text-fill:#a78bfa;
                                   -fx-font-size:11; -fx-font-weight:bold; -fx-padding:10 16 10 16;
                                   -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:1;
                                   -fx-border-color:rgba(124,58,237,0.5); -fx-border-radius:8;"/>
                </HBox>
                <WebView fx:id="webSuggestions" VBox.vgrow="ALWAYS" prefHeight="480"/>
            </VBox>
        </Tab>

        <!-- Tab 3 : Analyse globale -->
        <Tab text="Analyse globale">
            <VBox spacing="12" style="-fx-background-color:transparent; -fx-padding:16 0 0 0;">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <VBox spacing="3" HBox.hgrow="ALWAYS">
                        <Label text="Rapport d'analyse globale"
                               style="-fx-text-fill:white; -fx-font-size:14; -fx-font-weight:bold;"/>
                        <Label text="KPIs, tendances, points forts/faibles et recommandations strategiques"
                               style="-fx-text-fill:rgba(255,255,255,0.5); -fx-font-size:11;"/>
                    </VBox>
                    <ProgressIndicator fx:id="spinAnalyse" prefWidth="24" prefHeight="24"
                                       style="-fx-progress-color:#38bdf8;"/>
                    <Button fx:id="btnAnalyse" text="⚡  Générer" onAction="#onGenererAnalyse"
                            style="-fx-background-color:linear-gradient(to right,#0369a1,#38bdf8);
                                   -fx-text-fill:white; -fx-font-size:12; -fx-font-weight:bold;
                                   -fx-padding:10 22 10 22; -fx-background-radius:10; -fx-cursor:hand; -fx-border-width:0;"/>
                    <Button fx:id="btnPdfAnalyse" text="📥  PDF" onAction="#onPdfAnalyse"
                            style="-fx-background-color:rgba(3,105,161,0.25); -fx-text-fill:#38bdf8;
                                   -fx-font-size:11; -fx-font-weight:bold; -fx-padding:10 16 10 16;
                                   -fx-background-radius:8; -fx-cursor:hand; -fx-border-width:1;
                                   -fx-border-color:rgba(3,105,161,0.5); -fx-border-radius:8;"/>
                </HBox>
                <WebView fx:id="webAnalyse" VBox.vgrow="ALWAYS" prefHeight="480"/>
            </VBox>
        </Tab>
    </TabPane>

    <!-- EXTRA BOTTOM SPACE FOR SCROLLING -->
    <Region prefHeight="150" />

</VBox>